# PostgreSQL connection string (Supabase/Aiven pooled connection URI).
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Port the HTTP server listens on. Render injects its own PORT automatically —
# this is mainly for local development.
PORT=3000

# Runtime mode: development | production
NODE_ENV=development

# Admin login username (plain — not a secret by itself, but keep private).
ADMIN_USERNAME=

# Your actual admin password, typed directly — no hashing step needed.
# Compared with a constant-time check on every login, and never written
# anywhere but this env var (not the database, not a log).
ADMIN_PASSWORD=

# Used to sign session cookies and derive CSRF tokens. Any long random
# string works — 40+ characters from a password generator app is fine, it
# doesn't need to come from Node or be hex specifically. Just needs to be
# unpredictable and kept private.
SESSION_SECRET=

# Secret URL path segment where the admin dashboard lives — e.g. if set to
# "mgmt-9f2a", the admin panel is reachable ONLY at /mgmt-9f2a/*, never at
# a predictable /admin path. Just make one up yourself — letters/numbers/
# hyphens, no spaces or slashes. The harder it is to guess, the better.
ADMIN_PATH_SLUG=

# Used to encrypt Paystack/AI provider/hosting secrets at rest in
# Postgres (AES-256-GCM). Can be ANY string of any length — a phrase,
# random characters, whatever — it's hashed internally into a valid key.
# Just make it long and not something someone could guess.
ENCRYPTION_KEY=

# Deprecated as of v1.1.9 — no longer read by any code. These predate
# ClarityHeart, back when client sites deployed directly to Cloudflare
# Pages via the wrangler CLI. Hosting is now configured entirely on the
# Hosting admin page (System section of the sidebar) — there's no
# automatic migration from these into that config, since a Cloudflare API
# token and a ClarityHeart API token authenticate against two unrelated
# services. Safe to remove once Hosting is set up on the admin page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional, as of v1.1.1 — email is now configured via the Email Providers
# admin page (System section of the sidebar), not env vars. These two are
# now used for exactly one purpose: a one-time automatic migration into an
# active Resend provider, run once at boot, ONLY if the Email Providers
# table is still completely empty. Safe to leave unset for a fresh install
# — just add a provider through the dashboard instead. If you're upgrading
# from before v1.1.1 and already had these set, leave them as-is until
# you've confirmed email is working post-upgrade, then remove them.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional, as of v1.2.11 (also used by v1.2.13 promotions). The public
# address of this site, for example https://example.com with no trailing
# path. Review links, the admin review notification and the promotion
# snippets built on the admin Promotion page use it. When it is not set,
# promotion snippets use the address the admin is browsing from, and review
# links use the built-in default. Set it in production.
PUBLIC_BASE_URL=

# Optional, as of v1.2.17. All have safe defaults.
#
# How the visitor's address is worked out. auto (default): the Cloudflare
# header CF-Connecting-IP is believed only when the request really came from
# Cloudflare's published address ranges. off: never believe that header.
CLIENT_IP_CLOUDFLARE=
# Replaces the built in list of Cloudflare ranges (comma or space separated
# CIDR ranges, IPv4 and IPv6) without a code change. See lib/cloudflareRanges.js.
CLOUDFLARE_IP_RANGES=
# Wrong admin logins across all addresses in 15 minutes before every login
# attempt starts waiting a couple of seconds. Default 20.
LOGIN_SLOW_MODE_THRESHOLD=
# Minutes without use before an admin session ends (5 to 1440). Default 120.
ADMIN_SESSION_IDLE_MINUTES=
# Emergency switch. Set to true and restart to turn the two-step login off and
# clear its saved setup (for a lost phone and lost recovery codes). Remove it
# again once you are logged in.
ADMIN_DISABLE_TWO_STEP=

# v1.2.18 Withdrawals (all optional).
# Smallest unit amount held back from the balance check to cover Paystack's
# transfer fee, which is only known after a transfer. 0 by default.
WITHDRAWAL_FEE_ALLOWANCE_MINOR=
# Most withdrawal attempts (including refused ones) allowed in any hour.
WITHDRAWAL_MAX_ATTEMPTS_PER_HOUR=10
# How an M-Pesa number is sent to Paystack: 254 (254712345678, default), plus
# (+254712345678) or local (0712345678). Paystack's docs do not state it.
WITHDRAWAL_MPESA_FORMAT=254
# Allows saving Till numbers. Off because Paystack does not document what a
# Kenyan Till transfer needs as its account reference. Paybill is not offered.
WITHDRAWAL_ENABLE_TILL=
# Only for testing against a stand-in server. Leave empty in production.
PAYSTACK_API_BASE=

# v1.2.19 (all optional).
# The database provider's certificate, so the connection is properly verified.
# Paste the PEM text (-----BEGIN CERTIFICATE----- ...), or the same PEM with the
# line breaks written as \n, or the PEM base64 encoded. Empty keeps today's
# behaviour (encrypted, certificate not checked).
DATABASE_CA_CERT=
# How long a stored page can be used for checkout, in minutes (default 120).
RENDER_TTL_MINUTES=
# Most stored pages at once, and most total stored HTML in MB, across everyone
# (defaults 1000 and 250). Beyond these a new build gets a friendly "busy" message.
RENDER_MAX_STORED=
RENDER_MAX_TOTAL_MB=
