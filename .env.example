# PostgreSQL connection string (Supabase/Aiven pooled connection URI).
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Port the HTTP server listens on. Render injects its own PORT automatically —
# this is mainly for local development.
PORT=3000

# Runtime mode: development | production
NODE_ENV=development

# Admin login username (plain — not a secret by itself, but keep private).
ADMIN_USERNAME=

# bcrypt hash of the admin password — NEVER store or compare plaintext.
# Generate with: node -e "console.log(require('bcrypt').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# Long random string (32+ bytes) used to HMAC-sign session cookies and
# derive CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret URL path segment where the admin dashboard lives — e.g. if set to
# "mgmt-9f2a", the admin panel is reachable ONLY at /mgmt-9f2a/*, never at
# a predictable /admin path. Generate with the same crypto.randomBytes command above.
ADMIN_PATH_SLUG=

# 32-byte hex key used to encrypt Paystack/AI provider secrets at rest in
# Postgres (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
