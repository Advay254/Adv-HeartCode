# PostgreSQL connection string (Supabase/Aiven pooled connection URI).
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Port the HTTP server listens on. Render injects its own PORT automatically —
# this is mainly for local development.
PORT=3000

# Runtime mode: development | production
NODE_ENV=development

# Admin login username (plain — not a secret by itself, but keep private).
ADMIN_USERNAME=

# Your actual admin password, typed directly — no hashing step needed.
# Compared with a constant-time check on every login, and never written
# anywhere but this env var (not the database, not a log).
ADMIN_PASSWORD=

# Used to sign session cookies and derive CSRF tokens. Any long random
# string works — 40+ characters from a password generator app is fine, it
# doesn't need to come from Node or be hex specifically. Just needs to be
# unpredictable and kept private.
SESSION_SECRET=

# Secret URL path segment where the admin dashboard lives — e.g. if set to
# "mgmt-9f2a", the admin panel is reachable ONLY at /mgmt-9f2a/*, never at
# a predictable /admin path. Just make one up yourself — letters/numbers/
# hyphens, no spaces or slashes. The harder it is to guess, the better.
ADMIN_PATH_SLUG=

# Used to encrypt Paystack/AI provider secrets at rest in Postgres
# (AES-256-GCM). Can be ANY string of any length — a phrase, random
# characters, whatever — it's hashed internally into a valid key. Just
# make it long and not something someone could guess.
ENCRYPTION_KEY=
