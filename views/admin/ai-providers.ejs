<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>AI Provider — HeartCode Admin</title>
</head>
<body data-page="ai-provider">
<div class="admin-layout">
  <%- include('../partials/nav', { activePage: 'ai-provider' }) %>
  <main class="admin-main">
    <h1>AI Provider</h1>

    <div class="card">
      <h2>Add provider</h2>
      <form id="addProviderForm">
        <label>Label <input type="text" name="label" required placeholder="e.g. Groq"></label>
        <label>Base URL <input type="text" name="baseUrl" required placeholder="https://api.groq.com/openai/v1"></label>
        <button type="submit" style="margin-top:0.75rem;">Add provider</button>
      </form>
    </div>

    <div id="providersList"></div>
  </main>
</div>
</body>
</html>
