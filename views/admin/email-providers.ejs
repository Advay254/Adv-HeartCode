<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Email Providers — HeartCode Admin</title>
</head>
<body data-page="email-providers">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'email-providers' }) %>
  <main class="admin-main">
    <h1 class="mb-6 font-display text-2xl uppercase tracking-wide text-hc-ink">Email Providers</h1>
    <p class="mb-6 max-w-2xl text-sm text-slate-500">
      Add one or more email providers below, then mark one active — that's the one used for every outgoing email (site-ready notifications, per-website-type templates). Test a provider before activating it; a misconfigured SMTP provider fails silently otherwise.
    </p>

    <div class="admin-card max-w-xl">
      <h2 class="text-sm font-semibold text-hc-ink">Add provider</h2>
      <form id="addProviderForm">
        <label class="admin-label" for="providerPreset">Provider</label>
        <select class="admin-select" id="providerPreset">
          <option value="resend">Resend</option>
          <option value="gmail">Gmail SMTP</option>
          <option value="brevo">Brevo SMTP</option>
          <option value="smtp">Generic SMTP</option>
        </select>

        <label class="admin-label" for="providerLabel">Label</label>
        <input class="admin-input" type="text" id="providerLabel" required placeholder="e.g. Resend (production)">

        <!-- Resend fields -->
        <div data-fields="resend">
          <label class="admin-label" for="resendApiKey">API key</label>
          <input class="admin-input" type="password" id="resendApiKey" placeholder="re_...">
          <label class="admin-label" for="resendFromAddress">From address</label>
          <input class="admin-input" type="text" id="resendFromAddress" placeholder="hello@yourdomain.com">
          <p class="mt-1 text-xs text-slate-500">Must be on a Resend-verified domain.</p>
        </div>

        <!-- SMTP fields (shared by Gmail / Brevo / Generic presets) -->
        <div data-fields="smtp">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="admin-label" for="smtpHost">Host</label>
              <input class="admin-input" type="text" id="smtpHost" placeholder="smtp.example.com">
            </div>
            <div>
              <label class="admin-label" for="smtpPort">Port</label>
              <input class="admin-input" type="number" id="smtpPort" placeholder="587">
            </div>
          </div>
          <label class="admin-label" for="smtpSecurity">Connection security</label>
          <select class="admin-select" id="smtpSecurity">
            <option value="STARTTLS">STARTTLS (typically port 587)</option>
            <option value="SSL">SSL (typically port 465)</option>
            <option value="none">None (not recommended)</option>
          </select>
          <label class="admin-label" for="smtpUsername">Username</label>
          <input class="admin-input" type="text" id="smtpUsername" placeholder="e.g. your full email address">
          <label class="admin-label" for="smtpPassword">Password</label>
          <input class="admin-input" type="password" id="smtpPassword" placeholder="For Gmail, this must be an App Password, not your normal password">
          <label class="admin-label" for="smtpFromAddress">From address</label>
          <input class="admin-input" type="text" id="smtpFromAddress" placeholder="hello@yourdomain.com">
          <label class="admin-label" for="smtpFromName">From name (optional)</label>
          <input class="admin-input" type="text" id="smtpFromName" placeholder="HeartCode">
        </div>

        <p id="addProviderError" class="admin-msg admin-msg-error" style="display:none;"></p>
        <button type="submit" class="admin-btn mt-3">Add provider</button>
      </form>
    </div>

    <div id="providersList" class="mt-6 space-y-4"></div>
  </main>
</div>
</body>
</html>
