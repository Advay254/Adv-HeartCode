<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Explore Footer | HeartCode Admin</title>
</head>
<body data-page="landing-page">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'landing-page' }) %>
  <main class="admin-main">
    <section class="admin-page-intro">
      <div>
        <p class="admin-eyebrow">Content</p>
        <h1>Explore Page Footer</h1>
        <p>Edits the footer text and links shown on <code>/explore</code>.</p>
      </div>
      <div class="admin-page-actions">
        <a href="/explore" target="_blank" rel="noopener" class="admin-btn-outline">View /explore</a>
        <a href="/<%= slug %>/landing-sections" class="admin-btn-outline">Homepage sections</a>
      </div>
    </section>

    <div class="admin-callout">
      The homepage (<code>/</code>) itself is managed from <a href="/<%= slug %>/landing-sections">Landing Sections</a>.
      The hero text and &ldquo;how it works&rdquo; steps that used to live on this page no longer affect anything visible, so they've been removed from here.
    </div>

    <section class="admin-two-col">
      <div class="admin-card">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">Text</p><h2>Footer text</h2></div></div>
        <form id="contentForm">
          <label class="admin-label" for="footerText">Footer text</label>
          <input class="admin-input" type="text" name="footerText" id="footerText" maxlength="300">
          <div class="admin-form-actions">
            <button type="submit" class="admin-btn">Save</button>
            <p id="contentStatus" class="admin-msg" style="display:none;"></p>
          </div>
        </form>
      </div>

      <div class="admin-card">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">Links</p><h2>Footer links</h2></div></div>
        <form id="addFooterLinkForm">
          <div class="admin-form-grid-2">
            <div>
              <label class="admin-label" for="footerLinkLabel">Label</label>
              <input class="admin-input" type="text" name="label" id="footerLinkLabel" required maxlength="100">
            </div>
            <div>
              <label class="admin-label" for="footerLinkUrl">URL</label>
              <input class="admin-input" type="text" name="url" id="footerLinkUrl" required maxlength="500" placeholder="/explore or https://...">
            </div>
          </div>
          <div class="admin-form-actions"><button type="submit" class="admin-btn admin-btn-sm">Add link</button></div>
        </form>
        <div id="footerLinksList" class="mt-4 space-y-2"></div>
      </div>
    </section>
  </main>
</div>
</body>
</html>
