<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Landing Page — HeartCode Admin</title>
</head>
<body data-page="landing-page">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'landing-page' }) %>
  <main class="admin-main">
    <h1 class="mb-2 font-display text-2xl uppercase tracking-wide text-hc-ink">Footer (Explore page)</h1>
    <p class="mb-6 max-w-2xl text-sm text-slate-500">
      Edits the footer text and links shown on <code>/explore</code>. The homepage (<code>/</code>) itself is now
      managed from <a href="/<%= slug %>/landing-sections" class="text-hc-blue underline">Landing Sections</a> — the
      hero text and "how it works" steps that used to live on this page no longer affect anything visible, so
      they've been removed from here.
    </p>

    <div class="admin-card max-w-xl">
      <h2 class="text-sm font-semibold text-hc-ink">Footer text</h2>
      <form id="contentForm">
        <label class="admin-label" for="footerText">Footer text</label>
        <input class="admin-input" type="text" name="footerText" id="footerText" maxlength="300">
        <button type="submit" class="admin-btn mt-3">Save</button>
      </form>
      <p id="contentStatus" class="admin-msg" style="display:none;"></p>
    </div>

    <div class="admin-card mt-6 max-w-xl">
      <h2 class="text-sm font-semibold text-hc-ink">Footer links</h2>
      <form id="addFooterLinkForm" class="mt-2">
        <label class="admin-label" for="footerLinkLabel">Label</label>
        <input class="admin-input" type="text" name="label" id="footerLinkLabel" required maxlength="100">
        <label class="admin-label" for="footerLinkUrl">URL</label>
        <input class="admin-input" type="text" name="url" id="footerLinkUrl" required maxlength="500" placeholder="/explore or https://...">
        <button type="submit" class="admin-btn admin-btn-sm mt-2">Add link</button>
      </form>
      <div id="footerLinksList" class="mt-4 space-y-2"></div>
    </div>
  </main>
</div>
</body>
</html>
