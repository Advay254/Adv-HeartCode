<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Landing Sections | HeartCode Admin</title>
</head>
<body data-page="landing-sections">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'landing-sections' }) %>
  <main class="admin-main">
    <h1 class="mb-2 font-display text-2xl uppercase tracking-wide text-hc-ink">Landing Sections</h1>
    <p class="mb-6 max-w-2xl text-sm text-gray-500">
      Controls the sections shown on the homepage (<code>/</code>), top to bottom. Reorder with the arrows, toggle a
      section off without deleting it, or edit its text. Images aren't editable here: every image is a fixed asset
      from the current design, and a section you add fresh has no image available to it. The stats counter is the
      only section not managed here. It's a separate, always-on section, set from the Site Settings page instead.
    </p>

    <div class="admin-card max-w-xl">
      <h2 class="text-sm font-semibold text-hc-ink">Add section</h2>
      <form id="addSectionForm" class="mt-2">
        <label class="admin-label" for="newSectionType">Section type</label>
        <select class="admin-select" id="newSectionType">
          <% landingSectionTypes.forEach(function (t) { %>
            <option value="<%= t %>"><%= t %></option>
          <% }); %>
        </select>
        <button type="submit" class="admin-btn mt-3">Add section</button>
      </form>
    </div>

    <div id="sectionsList" class="mt-6 flex flex-col gap-4"></div>
  </main>
</div>

<script type="application/json" id="landingSectionsConfigData"><%- JSON.stringify({
  sectionTypes: landingSectionTypes,
  defaultContent: landingSectionDefaults,
  accentColors: landingAccentColors,
  iconNames: stepIconNames,
  adminSlug: slug
}) %></script>
</body>
</html>
