<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>HeartCode Admin Login</title>
</head>
<body data-page="login" data-slug="<%= slug %>">
<div class="admin-main" style="max-width:360px; margin:4rem auto;">
  <h1>Admin Login</h1>
  <form id="loginForm">
    <label>Username
      <input type="text" name="username" autocomplete="username" required>
    </label>
    <label>Password
      <span style="display:flex; gap:0.5rem; align-items:center;">
        <input type="password" name="password" id="passwordInput" autocomplete="current-password" required style="flex:1;">
        <button type="button" id="togglePassword" aria-label="Show password" style="padding:0.6rem 0.8rem; white-space:nowrap;">👁</button>
      </span>
    </label>
    <button type="submit" style="margin-top:1rem;">Log in</button>
  </form>
  <p id="error" class="msg msg-error" style="display:none;"></p>
</div>
</body>
</html>
