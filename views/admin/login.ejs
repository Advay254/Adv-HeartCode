<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>HeartCode Admin Login</title>
</head>
<body data-page="login" data-slug="<%= slug %>" class="flex min-h-screen items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="mb-6 flex items-center justify-center gap-2">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-accent-500 [&>svg]:h-4 [&>svg]:w-4">
        <%- getIconSvg('heart') %>
      </span>
      <span class="font-display text-xl uppercase tracking-wide text-brand-500">HeartCode Admin</span>
    </div>
    <div class="admin-card">
      <form id="loginForm">
        <label class="admin-label" for="usernameInput">Username</label>
        <input class="admin-input" type="text" name="username" id="usernameInput" autocomplete="username" required>

        <label class="admin-label" for="passwordInput">Password</label>
        <div class="flex items-center gap-2">
          <input class="admin-input" type="password" name="password" id="passwordInput" autocomplete="current-password" required>
          <button type="button" id="togglePassword" aria-label="Show password" class="admin-btn-outline shrink-0 px-3 py-2 [&>svg]:h-4 [&>svg]:w-4">
            <span id="togglePasswordShowIcon"><%- getIconSvg('eye') %></span>
            <span id="togglePasswordHideIcon" class="hidden"><%- getIconSvg('eye-off') %></span>
          </button>
        </div>

        <button type="submit" class="admin-btn mt-4 w-full">Log in</button>
      </form>
      <!-- v1.2.17: shown after a correct password when two-step login is on. -->
      <form id="codeForm" style="display:none;">
        <label class="admin-label" for="codeInput">Authentication code</label>
        <input class="admin-input" type="text" name="code" id="codeInput" autocomplete="one-time-code" maxlength="40" required>
        <p class="mt-1 text-xs text-gray-500">Enter the 6 digit code from your authenticator app, or one of your recovery codes.</p>
        <button type="submit" class="admin-btn mt-4 w-full">Verify</button>
        <button type="button" id="codeBackBtn" class="admin-btn-outline mt-2 w-full">Back</button>
      </form>
      <p id="error" class="admin-msg admin-msg-error" style="display:none;"></p>
    </div>
  </div>
</body>
</html>
