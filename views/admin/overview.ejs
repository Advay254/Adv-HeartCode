<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Dashboard | HeartCode Admin</title>
</head>
<body data-page="overview">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'overview' }) %>
  <main class="admin-main">
    <section class="admin-page-intro">
      <div>
        <p class="admin-eyebrow">HeartCode control center</p>
        <h1>Dashboard</h1>
        <p>See what is happening across your websites, payments, deployments, and services.</p>
      </div>
      <div class="admin-page-actions">
        <a href="/<%= slug %>/website-types" class="admin-btn-outline">Manage website types</a>
        <a href="/<%= slug %>/submissions" class="admin-btn">View deployments</a>
      </div>
    </section>

    <section class="admin-stat-grid" aria-label="Key metrics">
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><%- getIconSvg('credit-card') %></div>
        <div class="admin-stat-row"><div><p class="admin-stat-label">Payments</p><h4 id="statPaymentsValue" class="admin-stat-value">&hellip;</h4></div><span id="statPaymentsBadge"></span></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><%- getIconSvg('zap') %></div>
        <div class="admin-stat-row"><div><p class="admin-stat-label">AI Provider</p><h4 id="statAiProviderValue" class="admin-stat-value">&hellip;</h4></div></div>
        <p id="statAiProviderCaption" class="admin-stat-caption"></p>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><%- getIconSvg('layout-template') %></div>
        <div class="admin-stat-row"><div><p class="admin-stat-label">Website Types</p><h4 id="statWebsiteTypesValue" class="admin-stat-value">&hellip;</h4></div><span id="statWebsiteTypesBadge"></span></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><%- getIconSvg('rocket') %></div>
        <div class="admin-stat-row"><div><p class="admin-stat-label">Deployments</p><h4 id="statDeploymentsValue" class="admin-stat-value">&hellip;</h4></div></div>
        <p id="statDeploymentsCaption" class="admin-stat-caption"></p>
      </div>
    </section>

    <p id="statsError" class="admin-msg admin-msg-error" style="display:none;">Failed to load stats.</p>

    <section class="admin-dashboard-grid mt-6">
      <div class="admin-card">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">Performance</p><h2>Deployments by website type</h2></div></div>
        <div class="admin-table-wrap admin-table-wrap-inner">
          <table class="admin-table is-responsive-stack">
            <thead><tr><th>Type</th><th>Deployments</th><th>Revenue</th></tr></thead>
            <tbody id="statsBreakdownBody"><tr><td colspan="3" data-label="">Loading&hellip;</td></tr></tbody>
          </table>
        </div>
      </div>
      <aside class="admin-card admin-quick-actions">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">Shortcuts</p><h2>Quick actions</h2></div></div>
        <a href="/<%= slug %>/website-types" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('layout-template') %></span><span><strong>Manage website types</strong><small>Add, edit, price, or disable types</small></span><%- getIconSvg('chevron-right') %></a>
        <a href="/<%= slug %>/landing-page" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('pencil') %></span><span><strong>Edit landing page</strong><small>Update your public homepage</small></span><%- getIconSvg('chevron-right') %></a>
        <a href="/<%= slug %>/payments" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('credit-card') %></span><span><strong>Payment settings</strong><small>Check Paystack and currency settings</small></span><%- getIconSvg('chevron-right') %></a>
        <a href="/<%= slug %>/site-settings" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('wrench') %></span><span><strong>Site settings</strong><small>SEO, social links, and public metadata</small></span><%- getIconSvg('chevron-right') %></a>
      </aside>
    </section>
  </main>
</div>
</body>
</html>
