<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Dashboard | HeartCode Admin</title>
</head>
<body data-page="overview">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'overview' }) %>
  <main class="admin-main">
    <section class="admin-page-intro">
      <div>
        <p class="admin-eyebrow">HeartCode control center</p>
        <h1>Dashboard</h1>
        <p>See what is happening across your websites, payments, deployments, and services.</p>
      </div>
      <div class="admin-page-actions">
        <a href="/<%= slug %>/website-types" class="admin-btn-outline">Manage website types</a>
        <a href="/<%= slug %>/submissions" class="admin-btn">View deployments</a>
      </div>
    </section>

    <section class="admin-stat-grid admin-stat-grid-3" aria-label="Current configuration">
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><%- getIconSvg('credit-card') %></div>
        <div class="admin-stat-row"><div><p class="admin-stat-label">Payments</p><h4 id="statPaymentsValue" class="admin-stat-value">&hellip;</h4></div><span id="statPaymentsBadge"></span></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><%- getIconSvg('zap') %></div>
        <div class="admin-stat-row"><div><p class="admin-stat-label">AI Provider</p><h4 id="statAiProviderValue" class="admin-stat-value">&hellip;</h4></div></div>
        <p id="statAiProviderCaption" class="admin-stat-caption"></p>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><%- getIconSvg('layout-template') %></div>
        <div class="admin-stat-row"><div><p class="admin-stat-label">Website Types</p><h4 id="statWebsiteTypesValue" class="admin-stat-value">&hellip;</h4></div><span id="statWebsiteTypesBadge"></span></div>
      </div>
    </section>

    <p id="statsError" class="admin-msg admin-msg-error" style="display:none;">Failed to load configuration status.</p>

    <section class="admin-dashboard-grid mt-6">
      <div class="admin-card" id="analyticsCard">
        <div class="admin-section-heading">
          <div><p class="admin-eyebrow">Performance</p><h2>Analytics</h2></div>
          <div class="admin-range-controls">
            <select class="admin-select" id="analyticsRange" aria-label="Date range">
              <option value="today">Today</option>
              <option value="yesterday">Yesterday</option>
              <option value="7d">Last 7 days</option>
              <option value="30d" selected>Last 30 days</option>
              <option value="90d">Last 90 days</option>
              <option value="year">This year</option>
              <option value="all">All time</option>
              <option value="custom">Custom range&hellip;</option>
            </select>
            <button type="button" class="admin-btn-outline admin-btn-sm" id="analyticsRefresh" aria-label="Refresh analytics">Refresh</button>
          </div>
        </div>
        <div class="admin-filter-custom" id="analyticsCustomRange" hidden>
          <label>From <input type="date" id="analyticsFrom" class="admin-input"></label>
          <label>To <input type="date" id="analyticsTo" class="admin-input"></label>
        </div>
        <p id="analyticsError" class="admin-msg admin-msg-error" style="display:none;">Failed to load analytics.</p>

        <div class="admin-metric-grid" id="analyticsMetrics" aria-live="polite">
          <div class="admin-metric-card">
            <p class="admin-metric-label">Deployments</p>
            <h3 id="metricDeploymentsValue" class="admin-metric-value">&hellip;</h3>
            <p id="metricDeploymentsChange" class="admin-metric-change"></p>
          </div>
          <div class="admin-metric-card">
            <p class="admin-metric-label">Revenue</p>
            <h3 id="metricRevenueValue" class="admin-metric-value">&hellip;</h3>
            <p id="metricRevenueChange" class="admin-metric-change"></p>
          </div>
          <div class="admin-metric-card">
            <p class="admin-metric-label">New subscribers</p>
            <h3 id="metricSubscribersValue" class="admin-metric-value">&hellip;</h3>
            <p id="metricSubscribersChange" class="admin-metric-change"></p>
          </div>
        </div>

        <div class="admin-chart-grid">
          <div class="admin-chart-card">
            <p class="admin-chart-title">Deployments over time</p>
            <div class="admin-chart-wrap"><svg id="deploymentsChart" class="admin-chart" viewBox="0 0 600 220" preserveAspectRatio="none" role="img" aria-label="Deployments over time"></svg></div>
          </div>
          <div class="admin-chart-card">
            <p class="admin-chart-title">Revenue over time</p>
            <div class="admin-chart-wrap"><svg id="revenueChart" class="admin-chart" viewBox="0 0 600 220" preserveAspectRatio="none" role="img" aria-label="Revenue over time"></svg></div>
          </div>
        </div>

        <div class="admin-section-heading admin-breakdown-heading">
          <div><p class="admin-eyebrow">By type</p><h2>Website types</h2></div>
          <div class="admin-range-controls">
            <select class="admin-select" id="breakdownSort" aria-label="Sort website types by">
              <option value="deployments">Sort: Deployments</option>
              <option value="revenue">Sort: Revenue</option>
            </select>
          </div>
        </div>
        <div id="breakdownList" class="admin-breakdown-list"></div>
      </div>
      <aside class="admin-card admin-quick-actions">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">Shortcuts</p><h2>Quick actions</h2></div></div>
        <a href="/<%= slug %>/website-types" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('layout-template') %></span><span><strong>Manage website types</strong><small>Add, edit, price, or disable types</small></span><%- getIconSvg('chevron-right') %></a>
        <a href="/<%= slug %>/landing-sections" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('pencil') %></span><span><strong>Edit homepage sections</strong><small>Update your public homepage</small></span><%- getIconSvg('chevron-right') %></a>
        <a href="/<%= slug %>/payments" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('credit-card') %></span><span><strong>Payment settings</strong><small>Check Paystack and currency settings</small></span><%- getIconSvg('chevron-right') %></a>
        <a href="/<%= slug %>/site-settings" class="admin-action-link"><span class="admin-action-icon"><%- getIconSvg('wrench') %></span><span><strong>Site settings</strong><small>SEO, social links, and public metadata</small></span><%- getIconSvg('chevron-right') %></a>
      </aside>
    </section>
  </main>
</div>
</body>
</html>
