<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Payments — HeartCode Admin</title>
</head>
<body data-page="payments">
<div class="admin-layout">
  <%- include('../partials/nav', { activePage: 'payments' }) %>
  <main class="admin-main">
    <h1>Payments</h1>
    <p>Current mode: <span id="modeBadge" class="badge">…</span></p>

    <div class="card">
      <form id="paystackForm">
        <label>Mode
          <select name="mode" id="modeSelect">
            <option value="test">Test</option>
            <option value="live">Live</option>
          </select>
        </label>

        <h3>Test keys</h3>
        <label>Public key (test) <input type="text" id="publicKeyTest"></label>
        <label>Secret key (test) <input type="password" id="secretKeyTest" placeholder="Leave blank to keep current key"></label>
        <p id="secretTestMasked" class="msg" style="display:none;"></p>

        <h3>Live keys</h3>
        <label>Public key (live) <input type="text" id="publicKeyLive"></label>
        <label>Secret key (live) <input type="password" id="secretKeyLive" placeholder="Leave blank to keep current key"></label>
        <p id="secretLiveMasked" class="msg" style="display:none;"></p>

        <p style="margin-top:1rem;">
          <button type="submit">Save</button>
          <button type="button" id="clearTestBtn" class="btn-secondary">Clear test secret</button>
          <button type="button" id="clearLiveBtn" class="btn-secondary">Clear live secret</button>
        </p>
      </form>
      <p id="statusMsg" class="msg" style="display:none;"></p>
    </div>

    <div class="card">
      <h2>Kenyan visitor payment currency</h2>
      <p style="color:var(--text-dim); font-size:0.85rem;">
        Controls what currency Kenyan visitors are actually charged in. Leave this on USD until M-Pesa is set up and enabled on your Paystack account — until then, Kenyan visitors are charged in USD by card, exactly like everyone else.
      </p>
      <label>Charge Kenyan visitors in
        <select id="kenyanCurrencySelect">
          <option value="USD">USD (default — until M-Pesa is set up)</option>
          <option value="KES">KES (M-Pesa is set up on Paystack)</option>
        </select>
      </label>
      <p style="margin-top:0.75rem;">
        <button type="button" id="saveKenyanCurrencyBtn">Save</button>
      </p>
      <p id="kenyanCurrencyStatus" class="msg" style="display:none;"></p>
    </div>
  </main>
</div>


</html>
