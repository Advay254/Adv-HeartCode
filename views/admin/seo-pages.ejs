<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>SEO Pages | HeartCode Admin</title>
</head>
<body data-page="seo-pages">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'seo-pages' }) %>
  <main class="admin-main">
    <section class="admin-page-intro">
      <div>
        <p class="admin-eyebrow">Content</p>
        <h1>SEO Pages</h1>
        <p>Independent, keyword-targeted landing pages (e.g. <code>/thank-you-website</code>) alongside the homepage. Each has its own title, meta description, and content block.</p>
      </div>
    </section>

    <div class="admin-callout is-warn">
      A new page is <strong>not public until you save its content</strong>: click <strong>Content</strong> on the page below and write raw HTML or Markdown.
      The slug can't be changed after creation, since it's also that page's live URL.
    </div>

    <section class="admin-split-grid">
      <div class="admin-card admin-sticky-card">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">Create</p><h2>Add SEO page</h2></div></div>
        <form id="addSeoPageForm">
          <label class="admin-label" for="seoPageSlug">Slug</label>
          <input class="admin-input" type="text" name="slug" id="seoPageSlug" required placeholder="e.g. thank-you-website">
          <label class="admin-label" for="seoPagePageTitle">Page title</label>
          <input class="admin-input" type="text" name="pageTitle" id="seoPagePageTitle" required maxlength="200" placeholder="Browser tab / &lt;title&gt;">
          <label class="admin-label" for="seoPageMetaDescription">Meta description</label>
          <textarea class="admin-textarea" name="metaDescription" id="seoPageMetaDescription" required maxlength="500" placeholder="Shown in search results"></textarea>

          <details class="admin-form-legacy">
            <summary>Legacy call-to-action fields (not shown on the page)</summary>
            <div>
              <p class="admin-form-hint">Target website type and CTA button text are stored but no longer auto-inserted into the page. Fold a call-to-action link directly into the page's own content instead.</p>
              <label class="admin-label" for="seoPageTargetType">Target website type <span class="font-normal text-gray-400">(optional)</span></label>
              <select class="admin-select" name="targetWebsiteTypeId" id="seoPageTargetType">
                <option value="">None (CTA links to /explore instead)</option>
                <% websiteTypes.forEach(function (t) { %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
              </select>
              <label class="admin-label" for="seoPageCtaText">CTA button text</label>
              <input class="admin-input" type="text" name="ctaText" id="seoPageCtaText" maxlength="100" placeholder="Build this website">
            </div>
          </details>

          <div class="admin-form-actions">
            <button type="submit" class="admin-btn">Add SEO page</button>
            <p id="addSeoPageStatus" class="admin-msg" style="display:none;"></p>
          </div>
        </form>
      </div>

      <div class="admin-list-panel">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">Library</p><h2>Your SEO pages</h2></div></div>
        <div id="seoPagesList" class="admin-entry-list"></div>
      </div>
    </section>
  </main>
</div>
</body>
</html>
