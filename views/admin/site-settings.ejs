<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Site Settings | HeartCode Admin</title>
</head>
<body data-page="site-settings">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'site-settings' }) %>
  <main class="admin-main">
    <h1 class="mb-2 font-display text-2xl uppercase tracking-wide text-hc-ink">Site Settings</h1>
    <p class="mb-6 max-w-2xl text-sm text-gray-500">
      Feeds the landing page's stats section and every public page's favicon/meta tags. Admin dashboard's own look is unaffected.
    </p>

    <div class="admin-card max-w-xl">
      <form id="siteSettingsForm">
        <h2 class="text-sm font-semibold text-hc-ink">Landing page stats</h2>
        <label class="admin-label" for="manualStatsNumber">Stats number</label>
        <input class="admin-input" type="text" name="manual_stats_number" id="manualStatsNumber" placeholder="4500">
        <label class="admin-label" for="manualStatsLabel">Stats label</label>
        <input class="admin-input" type="text" name="manual_stats_label" id="manualStatsLabel" placeholder="Sites built and counting">

        <h2 class="mt-5 text-sm font-semibold text-hc-ink">Page meta</h2>
        <label class="admin-label" for="siteTitle">Site title</label>
        <input class="admin-input" type="text" name="site_title" id="siteTitle" placeholder="HeartCode">
        <label class="admin-label" for="metaDescription">Meta description</label>
        <textarea class="admin-textarea" name="meta_description" id="metaDescription" placeholder="Pick a website type, fill in your details, and get a live site in minutes."></textarea>
        <label class="admin-label" for="faviconUrl">Favicon URL</label>
        <input class="admin-input" type="url" name="favicon_url" id="faviconUrl" placeholder="https://example.com/favicon.png">
        <label class="admin-label" for="ogImageUrl">Social share image (OG) URL</label>
        <input class="admin-input" type="url" name="og_image_url" id="ogImageUrl" placeholder="https://example.com/og-image.png">
        <p class="mt-1 text-xs text-gray-400">Paste a hosted image URL. No upload here yet, same as the template/hero image workflow already in use.</p>

        <!-- v1.1.6 Part D: Organization structured data. Every field here
             is optional, leave any blank and it's simply left out of the
             Organization JSON-LD entirely (see routes/public.js), not
             emitted empty. -->
        <h2 class="mt-5 text-sm font-semibold text-hc-ink">Organization info (for search engines)</h2>
        <p class="mt-1 text-xs text-gray-400">Feeds the Organization structured data search engines read. None of this is shown directly on the site itself.</p>
        <label class="admin-label" for="logoUrl">Logo URL</label>
        <input class="admin-input" type="url" name="logo_url" id="logoUrl" placeholder="https://example.com/logo.png">
        <label class="admin-label" for="contactEmail">Contact email</label>
        <input class="admin-input" type="email" name="contact_email" id="contactEmail" placeholder="hello@example.com">
        <label class="admin-label" for="socialTwitterUrl">X / Twitter URL</label>
        <input class="admin-input" type="url" name="social_twitter_url" id="socialTwitterUrl" placeholder="https://x.com/yourhandle">
        <label class="admin-label" for="socialFacebookUrl">Facebook URL</label>
        <input class="admin-input" type="url" name="social_facebook_url" id="socialFacebookUrl" placeholder="https://facebook.com/yourpage">
        <label class="admin-label" for="socialInstagramUrl">Instagram URL</label>
        <input class="admin-input" type="url" name="social_instagram_url" id="socialInstagramUrl" placeholder="https://instagram.com/yourhandle">
        <label class="admin-label" for="socialLinkedinUrl">LinkedIn URL</label>
        <input class="admin-input" type="url" name="social_linkedin_url" id="socialLinkedinUrl" placeholder="https://linkedin.com/company/yourcompany">

        <h2 class="mt-5 text-sm font-semibold text-hc-ink">Type gallery &amp; form pricing</h2>
        <label class="admin-checkbox-label"><input type="checkbox" name="show_type_prices_early" id="showTypePricesEarly"> Show prices on the type gallery and form</label>
        <p class="mt-1 text-xs text-gray-500">
          Off by default: /explore's cards and the /build form header show no price at all, so a visitor decides based on the type itself (and its demo, if one's set) before seeing a number. Turn this on to show each type's price on both pages again. Either way, checkout always shows the real charge amount, and the "From $X" line on the landing page's category teaser is unaffected.
        </p>

        <button type="submit" class="admin-btn mt-4">Save site settings</button>
      </form>
      <p id="siteSettingsStatus" class="admin-msg" style="display:none;"></p>
    </div>

    <!-- v1.1.2 Part C: separate small card + its own save button, same
         pattern as the Payments page's Kenyan-currency toggle, this is a
         single standalone setting, not part of the bulk site-settings
         form above (which is scoped to the public <head>/landing-page
         values in lib/siteSettings.js's DEFAULTS). -->
    <div class="admin-card mt-6 max-w-xl">
      <h2 class="text-sm font-semibold text-hc-ink">Resend site details: daily limit</h2>
      <p class="mt-1 text-sm text-gray-500">
        Caps how many times a single visitor (by IP) can use the public <a href="/resend-details" class="text-brand-500">/resend-details</a> lookup per day. Kept low by default since this endpoint's job is looking up deployment history by email address.
      </p>
      <label class="admin-label" for="resendDetailsRateLimit">Lookups per IP per day</label>
      <input class="admin-input" type="number" id="resendDetailsRateLimit" min="1" max="1000" step="1">
      <button type="button" id="saveResendDetailsRateLimitBtn" class="admin-btn mt-4">Save</button>
      <p id="resendDetailsRateLimitStatus" class="admin-msg" style="display:none;"></p>
    </div>
  </main>
</div>
</body>
</html>
