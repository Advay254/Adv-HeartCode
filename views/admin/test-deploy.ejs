<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<title>Test Deploy: <%= websiteType.name %> | HeartCode Admin</title>
</head>
<body data-page="test-deploy" data-slug="<%= slug %>" data-type-slug="<%= websiteType.slug %>">
<div class="admin-shell">
  <%- include('../partials/nav', { activePage: 'website-types' }) %>
  <main class="admin-main">
    <section class="admin-page-intro">
      <div>
        <p class="admin-eyebrow">Website Types &middot; <%= websiteType.name %></p>
        <h1>Test Deploy</h1>
        <p class="tdp-lead">Build a real site for this type exactly as a customer would, with no payment. Same checks, same AI fill, same template.</p>
        <div class="tdp-chips">
          <span class="tdp-chip">Slug ends in <code>-test</code></span>
          <span class="tdp-chip">Email marked <code>[TEST]</code></span>
          <span class="tdp-chip">Not counted in revenue or alerts</span>
        </div>
      </div>
    </section>

    <% if (!websiteType.isActive) { %>
      <div class="admin-callout is-warn">This website type is not active yet, so visitors can't see it. A test deploy works anyway.</div>
    <% } %>
    <% if (!websiteType.hasActiveTemplate) { %>
      <div class="admin-callout is-warn">This website type has no active template yet. Save one on the Template tab before test deploying.</div>
    <% } %>

    <% var ui = {
      label: 'admin-label', input: 'admin-input', textarea: 'admin-textarea', select: 'admin-select',
      selectWrap: 'admin-select-wrap', optionList: 'admin-option-list', optionItem: 'admin-option-item',
      file: 'admin-input', imagePreview: 'admin-image-preview', hint: 'tdp-hint',
      required: '', icons: false, emailLabel: 'Client email', fieldWrap: 'tdp-field'
    };
    var optionalCount = fields.filter(function (f) { return !f.isRequired; }).length; %>

    <div class="tdp-grid">
      <form id="testDeployForm" class="tdp-card" autocomplete="off">
        <div class="tdp-section">
          <div class="tdp-section-head">
            <span class="tdp-step">1</span>
            <div><h2>Required details</h2><p>The test confirmation email goes to this address.</p></div>
          </div>
          <%- include('../partials/build-form-fields', { fields: fields, ui: Object.assign({ show: 'required' }, ui) }) %>
        </div>

        <% if (optionalCount > 0) { %>
        <details class="tdp-fold" id="tdpOptional">
          <summary>
            <span class="tdp-step">2</span>
            <div><h2>Optional details</h2><p>Leave empty to test the defaults and AI fill.</p></div>
            <span class="tdp-count"><%= optionalCount %></span>
            <span class="tdp-caret">&#9662;</span>
          </summary>
          <div class="tdp-fold-body">
            <%- include('../partials/build-form-fields', { fields: fields, ui: Object.assign({ show: 'optional' }, ui) }) %>
          </div>
        </details>
        <% } %>

        <details class="tdp-fold">
          <summary>
            <span class="tdp-step"><%= optionalCount > 0 ? 3 : 2 %></span>
            <div><h2>Password gate</h2><p>Optional. Turns on the password page for this test site.</p></div>
            <span class="tdp-caret">&#9662;</span>
          </summary>
          <div class="tdp-fold-body">
            <label class="admin-label" for="sitePassword" style="margin-top:0;">Site password</label>
            <input class="admin-input" type="text" name="sitePassword" id="sitePassword" placeholder="Leave blank for no password">
            <p class="tdp-hint">When set, the site is gated like a real password protected one, using this type's Password Page template.</p>
          </div>
        </details>

        <div class="tdp-bar">
          <button type="submit" id="testDeploySubmit" class="admin-btn">Run test deployment</button>
          <button type="button" id="tdpSample" class="admin-btn-outline">Fill required fields</button>
          <button type="button" id="tdpClear" class="admin-btn-outline">Clear</button>
          <span class="tdp-spacer"></span>
          <span class="tdp-hint" id="tdpSaved" style="margin:0;"></span>
        </div>
      </form>

      <aside class="tdp-card tdp-result" aria-live="polite">
        <h2>Result</h2>
        <div id="testDeployResult">
          <div class="tdp-empty"><strong>Nothing deployed yet</strong>Fill in the form and run a test. The live link shows up here.</div>
        </div>
        <div id="testDeployError" class="tdp-err" style="display:none;"></div>
        <div class="tdp-cleanup">
          <h3>Automatic cleanup</h3>
          <p class="tdp-hint">Test sites delete themselves from ClarityHeart after this many days, so the Test folder stays tidy. 0 keeps them forever.</p>
          <div class="tdp-cleanup-row">
            <input class="admin-input" type="number" id="testExpiryDays" min="0" max="30" step="1" style="max-width:110px;">
            <button type="button" class="admin-btn-outline" id="testExpirySave">Save</button>
            <span class="tdp-hint" id="testExpiryMsg" style="margin:0;"></span>
          </div>
        </div>
      </aside>
    </div>
  </main>
</div>
<script src="/dashboard-assets/admin-free.js" defer></script>
<script type="application/json" id="fieldKeysData"><%- JSON.stringify(fields.map(function (f) { return { key: f.fieldKey, type: f.fieldType, required: f.isRequired, options: f.dropdownOptions || [] }; })) %></script>
</body>
</html>
