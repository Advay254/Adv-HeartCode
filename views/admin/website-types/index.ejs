<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../../partials/head') %>
<title>Website Types — HeartCode Admin</title>
</head>
<body data-page="website-types-index" data-slug="<%= slug %>">
<div class="admin-layout">
  <%- include('../../partials/nav', { activePage: 'website-types' }) %>
  <main class="admin-main">
    <h1>Website Types</h1>

    <div class="card">
      <h2>Add website type</h2>
      <form id="addTypeForm">
        <label>Name <input type="text" name="name" required></label>
        <label>Slug (optional — auto-generated from name if left blank) <input type="text" name="slug"></label>
        <label>Description <textarea name="description" style="min-height:80px;"></textarea></label>
        <label>Price (USD) <input type="number" name="priceUsd" value="0" min="0" step="0.01"></label>
        <label>Icon
          <select name="iconName">
            <% iconNames.forEach(function (name) { %><option value="<%= name %>"><%= name %></option><% }); %>
          </select>
        </label>
        <button type="submit" style="margin-top:0.75rem;">Add website type</button>
      </form>
      <p id="addStatus" class="msg" style="display:none;"></p>
    </div>

    <div class="card">
      <table>
        <thead><tr><th>Name</th><th>Status</th><th>Fields</th><th>Template</th><th>Price</th><th></th></tr></thead>
        <tbody id="typesTableBody"></tbody>
      </table>
    </div>
  </main>
</div>

</body>
</html>
