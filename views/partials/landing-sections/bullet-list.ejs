<%
  var bl = section.content;
  var headingHtml = highlightWord(bl.heading, bl.highlighted_word, 'text-sk-blue');
  var imagePath = getLandingImageAsset(bl.image_asset_key);
%>
<section class="bg-sk-blue-pale/30 px-4 py-16 font-poppins sm:px-6">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 md:flex-row">
    <div class="w-full md:w-1/2" data-reveal="left">
      <h2 class="text-2xl font-bold text-hc-ink sm:text-3xl"><%- headingHtml %></h2>
      <% if (bl.body_text) { %>
        <p class="mt-3 text-hc-ink/60"><%= bl.body_text %></p>
      <% } %>
      <% if (bl.items && bl.items.length > 0) { %>
        <ul class="mt-7 flex flex-col gap-4">
          <% bl.items.forEach(function (item) { %>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-<%= item.icon_color %>/10 text-<%= item.icon_color %>">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
              <span class="text-sm text-hc-ink/80 sm:text-base"><%= item.text %></span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
    <div class="w-full md:w-1/2" data-reveal="right">
      <% if (imagePath) { %>
        <!-- v1.1.9 Part B alt-text audit: decorative (alt=""). This
             illustration sits beside a heading, body text, and a bulleted
             list that already fully state this section's point -- the
             image is a supporting visual, not a source of information a
             screen-reader user would otherwise miss. -->
        <img src="<%= imagePath %>" alt="" class="mx-auto w-full max-w-md rounded-2xl shadow-xl md:max-w-none" loading="lazy">
      <% } else { %>
        <div class="mx-auto aspect-[4/3] w-full max-w-md rounded-2xl bg-gradient-to-br from-sk-blue-pale via-white to-sk-yellow-pale shadow-inner md:max-w-none" role="img" aria-label=""></div>
      <% } %>
    </div>
  </div>
</section>
