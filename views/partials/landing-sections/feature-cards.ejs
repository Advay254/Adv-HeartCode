<%
  var fc = section.content;
  var headingHtml = highlightWord(fc.heading, fc.highlighted_word, 'text-sk-blue');
%>
<section id="how-it-works" class="bg-white px-4 py-20 font-poppins sm:px-6" data-reveal>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-sk-yellow-deep">How it works</p>
      <h2 class="mt-3 text-3xl font-bold text-hc-ink sm:text-4xl"><%- headingHtml %></h2>
    </div>

    <% if (!fc.cards || fc.cards.length === 0) { %>
      <p class="mt-12 text-center text-sm text-hc-ink/50">More on the way.</p>
    <% } else { %>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% fc.cards.forEach(function (card) { %>
          <div class="flex flex-col rounded-2xl bg-white p-8 shadow-xl shadow-hc-ink/5 ring-1 ring-black/5 transition-transform duration-300 hover:-translate-y-1" data-reveal>
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-<%= card.icon_color %>/10 text-<%= card.icon_color %> [&>svg]:h-6 [&>svg]:w-6">
              <%- getIconSvg(card.icon_name) %>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-hc-ink"><%= card.title %></h3>
            <p class="text-sm leading-relaxed text-hc-ink/60"><%= card.description %></p>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
