<%
  var t = section.content;
%>
<% if (t.items && t.items.length > 0) { %>
<section class="relative overflow-hidden bg-white px-4 py-16 font-poppins sm:px-6" data-reveal>
  <div class="pointer-events-none absolute -right-16 top-0 hidden h-64 w-64 opacity-90 lg:block">
    <!-- The original template's "TESTIMONIAL" section paired this image
         with header copy but no actual reviews — hardcoded here exactly
         like hero's image, since (like hero) there's only ever one
         testimonials section. See lib/landingSectionTypes.js's comment
         on testimonialsSchema.
         v1.1.9 Part B alt-text audit: decorative (alt=""). This is a
         corner-positioned background flourish unrelated to the actual
         testimonial content (each quote's author is identified by name/
         role text in the figcaption below, not a photo) -- purely
         atmospheric. -->
    <img src="/images/landing/testimonials.png" alt="" class="h-full w-full object-contain">
  </div>
  <div class="relative mx-auto max-w-6xl">
    <div class="max-w-xl">
      <% if (t.eyebrow_text) { %>
        <p class="text-sm font-bold uppercase tracking-widest text-sk-yellow-deep"><%= t.eyebrow_text %></p>
      <% } %>
      <h2 class="mt-3 text-2xl font-bold text-hc-ink sm:text-3xl"><%= t.heading %></h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% t.items.forEach(function (item) { %>
        <figure class="flex flex-col rounded-2xl bg-sk-yellow-pale/30 p-7 ring-1 ring-black/5" data-reveal>
          <blockquote class="text-sm leading-relaxed text-hc-ink/80">&ldquo;<%= item.quote %>&rdquo;</blockquote>
          <figcaption class="mt-5 text-sm">
            <span class="block font-semibold text-hc-ink"><%= item.author_name %></span>
            <% if (item.author_role) { %><span class="block text-hc-ink/50"><%= item.author_role %></span><% } %>
          </figcaption>
        </figure>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
