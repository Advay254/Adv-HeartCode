<%
  const navGroups = [
    {
      label: 'Website',
      icon: 'layout-template',
      items: [
        { page: 'website-types', href: `/${slug}/website-types`, label: 'Website Types', icon: 'layout-template' },
        { page: 'categories', href: `/${slug}/categories`, label: 'Categories', icon: 'tags' },
        { page: 'landing-sections', href: `/${slug}/landing-sections`, label: 'Landing Sections', icon: 'panels-top-left' },
        { page: 'landing-page', href: `/${slug}/landing-page`, label: 'Explore Footer', icon: 'panel-bottom' },
        { page: 'seo-pages', href: `/${slug}/seo-pages`, label: 'SEO Pages', icon: 'search' },
        { page: 'faq', href: `/${slug}/faq`, label: 'FAQ', icon: 'circle-help' },
        { page: 'legal-pages', href: `/${slug}/legal-pages`, label: 'Legal Pages', icon: 'scale' }
      ]
    },
    {
      label: 'Marketing',
      icon: 'megaphone',
      items: [
        { page: 'promotion', href: `/${slug}/promotion`, label: 'Promotion', icon: 'megaphone' },
        { page: 'ad-cards', href: `/${slug}/ad-cards`, label: 'Ad Cards', icon: 'newspaper' },
        { page: 'reviews', href: `/${slug}/reviews`, label: 'Reviews', icon: 'star', badge: 'pendingReviews' },
        { page: 'coupons', href: `/${slug}/coupons`, label: 'Coupons', icon: 'tags' },
        { page: 'funnel', href: `/${slug}/funnel`, label: 'Funnel', icon: 'funnel' }
      ]
    },
    {
      label: 'Sales',
      icon: 'credit-card',
      items: [
        { page: 'submissions', href: `/${slug}/submissions`, label: 'Deployments & Subscribers', icon: 'rocket' },
        { page: 'free', href: `/${slug}/free`, label: 'Free Deployments', icon: 'gift' },
        { page: 'payments', href: `/${slug}/payments`, label: 'Payments', icon: 'credit-card' },
        { page: 'withdrawals', href: `/${slug}/withdrawals`, label: 'Withdrawals', icon: 'wallet' },
        { page: 'recovery', href: `/${slug}/recovery`, label: 'Recovery', icon: 'history' },
        { page: 'activity', href: `/${slug}/activity`, label: 'Activity', icon: 'activity' }
      ]
    },
    {
      label: 'Settings',
      icon: 'settings',
      items: [
        { page: 'site-settings', href: `/${slug}/site-settings`, label: 'Site Settings', icon: 'settings' },
        { page: 'scripts', href: `/${slug}/scripts`, label: 'Scripts', icon: 'code' },
        { page: 'ai-provider', href: `/${slug}/ai-provider`, label: 'AI Provider', icon: 'sparkles' },
        { page: 'hosting', href: `/${slug}/hosting`, label: 'Hosting', icon: 'server' },
        { page: 'email-providers', href: `/${slug}/email-providers`, label: 'Email Providers', icon: 'mail' },
        { page: 'notifications', href: `/${slug}/notifications`, label: 'Notifications', icon: 'bell' },
        { page: 'security', href: `/${slug}/security`, label: 'Security', icon: 'shield-check' }
      ]
    }
  ];

  const pageTitles = {
    overview: 'Dashboard',
    'website-types': 'Website Types',
    categories: 'Categories',
    'landing-page': 'Explore Footer',
    'landing-sections': 'Landing Sections',
    'seo-pages': 'SEO Pages',
    faq: 'FAQ',
    'legal-pages': 'Legal Pages',
    'site-settings': 'Site Settings',
    scripts: 'Scripts',
    promotion: 'Promotion',
    'ad-cards': 'Ad Cards',
    submissions: 'Deployments & Subscribers',
    activity: 'Activity',
    reviews: 'Reviews',
    payments: 'Payments',
    withdrawals: 'Withdrawals',
    recovery: 'Recovery',
    funnel: 'Funnel',
    free: 'Free Deployments',
    coupons: 'Coupons',
    'ai-provider': 'AI Provider',
    hosting: 'Hosting',
    'email-providers': 'Email Providers',
    notifications: 'Notifications',
    security: 'Security'
  };
  const currentPageTitle = pageTitles[activePage] || 'Admin';
%>
<header class="admin-topbar">
  <div class="admin-topbar-left">
    <button type="button" id="sidebarToggle" class="admin-topbar-menu-btn" aria-label="Open navigation" aria-expanded="false">
      <%- getIconSvg('menu') %>
    </button>
    <a href="/<%= slug %>/" class="admin-topbar-brand">HeartCode</a>
    <div class="admin-breadcrumb" aria-label="Current page">
      <span class="admin-breadcrumb-muted">Admin</span>
      <%- getIconSvg('chevron-right') %>
      <strong><%= currentPageTitle %></strong>
    </div>
  </div>

  <div class="admin-topbar-actions">
    <a href="/" class="admin-topbar-site-link" target="_blank" rel="noopener" aria-label="View site (opens in a new tab)" title="View site">
      <%- getIconSvg('external-link') %>
      <span>View site</span>
    </a>
    <span class="admin-session">
      <span data-avatar><%- getIconSvg('circle-user') %></span>
      <span class="admin-session-name">Admin</span>
    </span>
    <button type="button" id="logoutBtn" class="admin-btn-outline admin-btn-sm">Logout</button>
  </div>
</header>

<div class="admin-sidebar-overlay" id="sidebarOverlay"></div>

<aside class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar-header">
    <a href="/<%= slug %>/" class="admin-sidebar-brand">
      <span class="admin-logo-mark"><%- getIconSvg('heart') %></span>
      <span>HeartCode <small>Admin</small></span>
    </a>
    <button type="button" id="sidebarClose" class="admin-sidebar-close" aria-label="Close navigation">
      <%- getIconSvg('x') %>
    </button>
  </div>

  <nav class="admin-sidebar-nav" aria-label="Admin navigation">
    <a href="/<%= slug %>/" class="admin-dashboard-link <%= activePage === 'overview' ? 'is-active' : '' %>">
      <span class="admin-nav-icon"><%- getIconSvg('house') %></span>
      <span>Dashboard</span>
    </a>

    <% navGroups.forEach(function (group, groupIndex) { %>
      <% const isGroupActive = group.items.some(function (item) { return item.page === activePage; }); %>
      <div class="admin-nav-group">
        <button
          type="button"
          class="admin-nav-group-toggle <%= isGroupActive ? 'is-active' : '' %>"
          data-nav-toggle
          aria-expanded="<%= isGroupActive ? 'true' : 'false' %>"
          aria-controls="navGroup<%= groupIndex %>"
        >
          <span class="admin-nav-icon"><%- getIconSvg(group.icon) %></span>
          <span><%= group.label %></span>
          <span class="admin-nav-chevron"><%- getIconSvg('chevron-down') %></span>
        </button>
        <div class="admin-nav-group-children <%= isGroupActive ? 'is-open' : '' %>" id="navGroup<%= groupIndex %>">
          <% group.items.forEach(function (item) { %>
            <% const itemActive = activePage === item.page; %>
            <a href="<%= item.href %>" class="admin-nav-child <%= itemActive ? 'is-active' : '' %>">
              <span class="admin-nav-child-icon"><%- getIconSvg(item.icon) %></span>
              <span><%= item.label %></span>
              <% if (item.badge === 'pendingReviews' && typeof pendingReviewCount !== 'undefined' && pendingReviewCount > 0) { %>
                <span class="admin-badge admin-badge-brand ml-auto" aria-label="<%= pendingReviewCount %> pending review<%= pendingReviewCount === 1 ? '' : 's' %>"><%= pendingReviewCount %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </nav>

  <div class="admin-sidebar-footer">
    <div class="admin-sidebar-footer-card">
      <span class="admin-status-dot"></span>
      <div>
        <strong>Signed in</strong>
        <span>Admin session active</span>
      </div>
    </div>
  </div>
</aside>
