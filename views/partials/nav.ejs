<!-- v1.0.8 Part D: mobile top bar (hamburger + brand), sidebar (desktop:
     always visible, sticky; mobile: off-canvas drawer toggled by the
     hamburger, see public/dashboard-assets/admin.js's initNav), and the
     mobile backdrop overlay.

     v1.1.7 (TailAdmin visual redesign): the top bar is now a persistent
     header at every breakpoint (not just mobile) carrying a session
     indicator + logout — see src/styles/admin.css's own comment on
     .admin-topbar for why the right-hand side is scoped to just that
     (no search bar, no notification bell, no multi-user profile menu:
     none of that exists in this single-admin app). The sidebar's nav is
     now grouped into collapsible accordion sections (Content / Revenue /
     System) instead of a flat list under static group labels — same
     three groupings as before, just collapsible now, plus a fourth page
     (Landing Sections) that existed in the app already but had no nav
     entry at all until now; it's filed under Content next to the two
     pages that link to it. The group containing the current page starts
     expanded (rendered server-side below, not computed by JS) so there's
     no flash of a collapsed-then-expanding menu on load.

     v1.1.8 (redo, exact structures): every nav link/toggle below now uses
     TailAdmin's own literal .menu-item / .menu-item-active / .menu-item-
     inactive / .menu-item-icon-active / .menu-item-icon-inactive /
     .menu-item-arrow-active / .menu-item-arrow-inactive class names
     (defined in src/styles/admin.css, ported verbatim from TailAdmin's
     src/index.css) in place of v1.1.7's own admin-nav-link / admin-nav-
     group-toggle / admin-nav-group-chevron names — same behavior, the
     literal reference class names this redo's build brief specifically
     asks for. Sub-items use TailAdmin's separate .menu-dropdown-item
     family, also verbatim. -->
<%
  const navGroups = [
    {
      label: 'Content',
      items: [
        { page: 'website-types', href: `/${slug}/website-types`, icon: 'layout-template', label: 'Website Types' },
        { page: 'landing-sections', href: `/${slug}/landing-sections`, icon: 'sparkles', label: 'Landing Sections' },
        { page: 'landing-page', href: `/${slug}/landing-page`, icon: 'globe', label: 'Landing Page' },
        { page: 'faq', href: `/${slug}/faq`, icon: 'book-open', label: 'FAQ' },
        { page: 'categories', href: `/${slug}/categories`, icon: 'gift', label: 'Categories' },
        { page: 'site-settings', href: `/${slug}/site-settings`, icon: 'wrench', label: 'Site Settings' },
        { page: 'scripts', href: `/${slug}/scripts`, icon: 'palette', label: 'Scripts' }
      ]
    },
    {
      label: 'Revenue',
      items: [
        { page: 'submissions', href: `/${slug}/submissions`, icon: 'circle-check', label: 'Submissions' },
        { page: 'payments', href: `/${slug}/payments`, icon: 'credit-card', label: 'Payments' },
        { page: 'recovery', href: `/${slug}/recovery`, icon: 'shield-check', label: 'Recovery' },
        { page: 'funnel', href: `/${slug}/funnel`, icon: 'users', label: 'Funnel' }
      ]
    },
    {
      label: 'System',
      items: [
        { page: 'ai-provider', href: `/${slug}/ai-provider`, icon: 'zap', label: 'AI Provider' },
        { page: 'email-providers', href: `/${slug}/email-providers`, icon: 'mail', label: 'Email Providers' },
        { page: 'notifications', href: `/${slug}/notifications`, icon: 'bell', label: 'Notifications' }
      ]
    }
  ];
%>
<div class="admin-topbar">
  <div class="admin-topbar-left">
    <button type="button" id="sidebarToggle" class="admin-topbar-menu-btn" aria-label="Open menu" aria-expanded="false">
      <%- getIconSvg('menu') %>
    </button>
    <span class="admin-topbar-brand">HeartCode</span>
  </div>
  <div class="admin-topbar-identity">
    <span data-avatar><%- getIconSvg('circle-user') %></span>
    Admin
    <button type="button" id="logoutBtn" class="admin-btn-outline admin-btn-sm ml-2">Logout</button>
  </div>
</div>

<div class="admin-sidebar-overlay" id="sidebarOverlay"></div>

<aside class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar-header">
    <span class="admin-sidebar-brand">HeartCode Admin</span>
    <button type="button" id="sidebarClose" class="admin-sidebar-close" aria-label="Close menu">
      <%- getIconSvg('x') %>
    </button>
  </div>

  <nav class="admin-sidebar-nav">
    <% const overviewActive = activePage === 'overview'; %>
    <a href="/<%= slug %>/" class="menu-item <%= overviewActive ? 'menu-item-active' : 'menu-item-inactive' %>">
      <span data-menu-icon class="<%= overviewActive ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>"><%- getIconSvg('house') %></span>
      Overview
    </a>

    <% navGroups.forEach(function (group, groupIndex) { %>
      <% const isGroupActive = group.items.some(function (item) { return item.page === activePage; }); %>
      <p class="admin-nav-group-label"><%= group.label %></p>
      <button
        type="button"
        class="menu-item <%= isGroupActive ? 'menu-item-active' : 'menu-item-inactive' %>"
        data-nav-toggle
        aria-expanded="<%= isGroupActive ? 'true' : 'false' %>"
        aria-controls="navGroup<%= groupIndex %>"
      >
        <span data-menu-icon class="<%= isGroupActive ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>"><%- getIconSvg(group.items[0].icon) %></span>
        <%= group.label %>
        <span class="menu-item-arrow <%= isGroupActive ? 'menu-item-arrow-active' : 'menu-item-arrow-inactive' %>"><%- getIconSvg('chevron-down') %></span>
      </button>
      <div class="admin-nav-group-children <%= isGroupActive ? 'is-open' : '' %>" id="navGroup<%= groupIndex %>">
        <% group.items.forEach(function (item) { %>
          <% const itemActive = activePage === item.page; %>
          <a href="<%= item.href %>" class="menu-dropdown-item <%= itemActive ? 'menu-dropdown-item-active' : 'menu-dropdown-item-inactive' %>">
            <%= item.label %>
          </a>
        <% }); %>
      </div>
    <% }); %>
  </nav>
</aside>
