<!-- v1.0.8 Part D: mobile top bar (hamburger + brand), sidebar (desktop:
     always visible, sticky; mobile: off-canvas drawer toggled by the
     hamburger, see public/dashboard-assets/admin.js's initNav), and the
     mobile backdrop overlay. Grouped into Overview / Content / Revenue /
     System, matching how these pages actually relate to each other
     rather than one flat list. -->
<div class="admin-topbar">
  <button type="button" id="sidebarToggle" class="admin-btn-outline admin-btn-sm [&>svg]:h-5 [&>svg]:w-5" aria-label="Open menu" aria-expanded="false">
    <%- getIconSvg('menu') %>
  </button>
  <span class="font-display text-lg uppercase tracking-wide text-hc-blue">HeartCode</span>
  <span class="w-9"></span>
</div>

<div class="admin-sidebar-overlay" id="sidebarOverlay"></div>

<aside class="admin-sidebar" id="adminSidebar">
  <div class="mb-6 flex items-center justify-between">
    <span class="font-display text-lg uppercase tracking-wide text-hc-blue">HeartCode Admin</span>
    <button type="button" id="sidebarClose" class="text-slate-400 hover:text-hc-ink [&>svg]:h-5 [&>svg]:w-5 lg:hidden" aria-label="Close menu">
      <%- getIconSvg('x') %>
    </button>
  </div>

  <nav>
    <p class="admin-nav-group-label">Overview</p>
    <a href="/<%= slug %>/" class="admin-nav-link <%= activePage === 'overview' ? 'active' : '' %>">
      <%- getIconSvg('house') %> Overview
    </a>

    <p class="admin-nav-group-label">Content</p>
    <a href="/<%= slug %>/website-types" class="admin-nav-link <%= activePage === 'website-types' ? 'active' : '' %>">
      <%- getIconSvg('layout-template') %> Website Types
    </a>
    <a href="/<%= slug %>/landing-page" class="admin-nav-link <%= activePage === 'landing-page' ? 'active' : '' %>">
      <%- getIconSvg('sparkles') %> Landing Page
    </a>
    <a href="/<%= slug %>/site-settings" class="admin-nav-link <%= activePage === 'site-settings' ? 'active' : '' %>">
      <%- getIconSvg('wrench') %> Site Settings
    </a>
    <a href="/<%= slug %>/scripts" class="admin-nav-link <%= activePage === 'scripts' ? 'active' : '' %>">
      <%- getIconSvg('globe') %> Scripts
    </a>

    <p class="admin-nav-group-label">Revenue</p>
    <a href="/<%= slug %>/submissions" class="admin-nav-link <%= activePage === 'submissions' ? 'active' : '' %>">
      <%- getIconSvg('circle-check') %> Submissions
    </a>
    <a href="/<%= slug %>/recovery" class="admin-nav-link <%= activePage === 'recovery' ? 'active' : '' %>">
      <%- getIconSvg('shield-check') %> Recovery
    </a>
    <a href="/<%= slug %>/funnel" class="admin-nav-link <%= activePage === 'funnel' ? 'active' : '' %>">
      <%- getIconSvg('users') %> Funnel
    </a>
    <a href="/<%= slug %>/payments" class="admin-nav-link <%= activePage === 'payments' ? 'active' : '' %>">
      <%- getIconSvg('credit-card') %> Payments
    </a>

    <p class="admin-nav-group-label">System</p>
    <a href="/<%= slug %>/ai-provider" class="admin-nav-link <%= activePage === 'ai-provider' ? 'active' : '' %>">
      <%- getIconSvg('zap') %> AI Provider
    </a>
  </nav>

  <div class="mt-6 border-t border-slate-200 pt-4">
    <button type="button" id="logoutBtn" class="admin-btn-outline w-full">Logout</button>
  </div>
</aside>
