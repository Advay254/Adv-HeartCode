<%# v1.2.16: analytics loader. Rendered only when analytics is on and the page is allowed to be tracked (lib/analytics.js buildPageContext). Every value comes from saved settings. %>
<script src="<%= analytics.loaderSrc %>" defer data-hc-loader data-src="<%= analytics.trackerSrc %>" data-website-id="<%= analytics.websiteId %>" data-domains="<%= analytics.domains %>" data-dnt="<%= analytics.dnt %>" data-perf="<%= analytics.perf %>" data-lazy="<%= analytics.lazy %>" data-proxy="<%= analytics.proxy %>"<% if (analytics.recorderSrc) { %> data-rec="<%= analytics.recorderSrc %>"<% } %><% if (analytics.events && analytics.events.length) { %> data-events="<%= JSON.stringify(analytics.events) %>"<% } %>></script>
