<footer class="border-t border-black/5 bg-white">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-10 text-center sm:flex-row sm:justify-between sm:px-6 sm:text-left">
    <div class="flex items-center gap-2 font-sans font-semibold text-hc-ink">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-hc-blue text-hc-yellow [&>svg]:h-3.5 [&>svg]:w-3.5">
        <%- getIconSvg('heart') %>
      </span>
      <span><%= siteSettings.site_title %></span>
    </div>
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-hc-ink/60">
      <% (landingFooterLinks || []).forEach(function (link) { %>
        <a href="<%= link.url %>" class="transition-colors hover:text-hc-ink"><%= link.label %></a>
      <% }); %>
    </nav>
    <p class="text-xs text-hc-ink/40"><%= landingContent.footerText %></p>
  </div>
</footer>
