<footer class="border-t border-black/5 bg-white">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-10 text-center sm:flex-row sm:justify-between sm:px-6 sm:text-left">
    <div class="flex items-center gap-2 font-sans font-semibold text-hc-ink">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-hc-blue text-hc-yellow [&>svg]:h-3.5 [&>svg]:w-3.5">
        <%- getIconSvg('heart') %>
      </span>
      <span><%= siteSettings.site_title %></span>
    </div>
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-hc-ink/60">
      <% (landingFooterLinks || []).forEach(function (link) { %>
        <a href="<%= link.url %>" class="transition-colors hover:text-hc-ink"><%= link.label %></a>
      <% }); %>
    </nav>
    <p class="text-xs text-hc-ink/40"><%= landingContent.footerText %></p>
  </div>
  <!-- v1.2.1 Part A: the three legal pages, on every page this partial
       renders on (build/checkout/explore/resend-details). Hardcoded
       links, not admin-managed like landingFooterLinks above — these
       three routes are fixed and always exist (see routes/public.js),
       unlike that list which an admin builds from scratch. -->
  <div class="border-t border-black/5 py-4">
    <nav class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-6 gap-y-2 px-4 text-xs text-hc-ink/40 sm:px-6">
      <a href="/privacy-policy" class="transition-colors hover:text-hc-ink/60">Privacy Policy</a>
      <a href="/terms" class="transition-colors hover:text-hc-ink/60">Terms and Conditions</a>
      <a href="/cookie-policy" class="transition-colors hover:text-hc-ink/60">Cookie Policy</a>
    </nav>
  </div>
</footer>
