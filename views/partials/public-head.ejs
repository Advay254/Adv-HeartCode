<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ', ' + siteSettings.site_title : siteSettings.site_title %></title>
<%
  // v1.1.2 Part A: per-page meta description override, same fallback shape
  // as pageTitle above -- a route can pass `pageDescription` (e.g. a
  // website type's seo_description) to target that page's own search
  // intent; any page that doesn't set it keeps today's exact behavior
  // (the global siteSettings.meta_description).
  var effectiveDescription = (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : siteSettings.meta_description;
%>
<meta name="description" content="<%= effectiveDescription %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ', ' + siteSettings.site_title : siteSettings.site_title %>">
<meta property="og:description" content="<%= effectiveDescription %>">
<% if (siteSettings.og_image_url) { %><meta property="og:image" content="<%= siteSettings.og_image_url %>"><% } %>
<% if (siteSettings.favicon_url) { %><link rel="icon" href="<%= siteSettings.favicon_url %>"><% } %>

<!-- v1.0.7: preconnect hints for the two Google Fonts hosts, ahead of the
     @import inside /styles/main.css that actually requests Anton + Inter
     — lets the browser open both connections before it's even finished
     downloading/parsing the stylesheet that needs them. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/styles/main.css">
<link rel="stylesheet" href="/site.css">
<script src="/site-interactions.js" defer></script>
<script src="/funnel.js" defer></script>
<script src="/site.js" defer></script>

<% if (typeof activeScripts !== 'undefined' && activeScripts.head && activeScripts.head.length) { %>
<%# v1.0.7: admin-pasted third-party snippets (routes/adminScripts.js), rendered
    verbatim -- this is exactly the injection point publicCsp in server.js
    was loosened for. Public pages only; see that file's comment and
    lib/siteScripts.js for why this never reaches an admin-authenticated render. %>
<% activeScripts.head.forEach(function (scriptContent) { %>
<%- scriptContent %>
<% }); %>
<% } %>

<% if (typeof structuredData !== 'undefined' && structuredData && structuredData.length) { %>
<%#
  v1.1.2 Part A: JSON-LD structured data. A route passes an ARRAY of plain
  JS objects (never a pre-built string -- JSON.stringify below is what
  actually serializes it, so there's no way for this to end up
  double-encoded or hand-assembled). publicCsp already allows
  'unsafe-inline' script-src (see server.js's comment on that policy,
  added in v1.0.7 for the script-injection manager) so a plain inline
  <script type="application/ld+json"> block here needs no further CSP
  changes -- 'unsafe-inline' covers any inline script content, not just
  the admin-pasted kind above.
  Each object is expected to be one complete schema.org entity (e.g. one
  Organization, one Product) -- see routes/public.js for what's actually
  built for the homepage vs. a /build/:slug page.
%>
<% structuredData.forEach(function (entity) { %>
<script type="application/ld+json"><%- JSON.stringify(entity) %></script>
<% }); %>
<% } %>
