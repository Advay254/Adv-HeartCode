<%#
  v1.2.12: one public review. Used by /testimonials, a website type's build
  page, and a landing page testimonials block, so every public place applies
  the same rules:
    - the reviewer's own star rating only (never an average or summary)
    - a "Verified client" label with a check icon, always
    - the website type title underneath (showType true): a link to
      /build/:slug only while the type is currently active, otherwise the
      word "Discontinued" with no link. The query already returns NULL for
      the name and slug of an inactive or deleted type, so a deleted type's
      name cannot appear here even by mistake.
    - everything is printed with the escaping EJS tag. Nothing here uses the
      raw tag for review text, names or URLs.
  Locals: review, showType (boolean).
%>
<%
  var rv = review;
  var rvStars = Number(rv.rating) || 0;
%>
<article class="rvd-card">
  <div class="rvd-card-top">
    <span class="rvd-stars" role="img" aria-label="Rated <%= rvStars %> out of 5">
      <% for (var i = 1; i <= 5; i++) { %>
        <svg class="rvd-star<%= i <= rvStars ? ' is-on' : '' %>" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
      <% } %>
    </span>
    <span class="rvd-verified">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg>
      Verified client
    </span>
  </div>

  <blockquote class="rvd-text">&ldquo;<%= rv.text %>&rdquo;</blockquote>

  <div class="rvd-person">
    <% if (rv.imageUrl) { %>
      <img class="rvd-photo" src="<%= rv.imageUrl %>" alt="Photo shared by <%= rv.name %>" width="56" height="56" loading="lazy" decoding="async">
    <% } %>
    <div>
      <p class="rvd-name"><%= rv.name %></p>
      <% if (showType) { %>
        <p class="rvd-type">
          <% if (rv.typeSlug && rv.typeTitle) { %>
            <a class="rvd-link" href="/build/<%= encodeURIComponent(rv.typeSlug) %>"><%= rv.typeTitle %></a>
          <% } else { %>
            <span>Discontinued</span>
          <% } %>
        </p>
      <% } %>
    </div>
  </div>
</article>
