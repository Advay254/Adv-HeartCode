<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/public-head') %>
</head>
<body class="bg-white font-sans text-hc-ink antialiased" data-page="build" data-slug="<%= websiteType.slug %>" data-website-type-id="<%= websiteType.id %>">
<%- include('../partials/public-body-start-scripts') %>

<%- include('../partials/public-nav') %>

<section class="bg-hc-blue px-4 py-12 text-center sm:px-6 sm:py-16">
  <div class="mx-auto max-w-2xl" data-reveal>
    <p class="mb-3 inline-block rounded-full bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-hc-yellow">
      <%= websiteType.name %>
    </p>
    <h1 class="font-display text-3xl uppercase text-white sm:text-4xl">Let's get the details</h1>
    <% if (siteSettings.show_type_prices_early === 'true') { %>
    <p class="mt-4 text-lg font-semibold text-white"><%= websiteType.displayPrimary %></p>
    <% if (websiteType.displaySecondary) { %><p class="text-sm text-white/70"><%= websiteType.displaySecondary %></p><% } %>
    <% } %>
  </div>
</section>

<main class="bg-white px-4 py-12 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <div class="hc-panel border border-black/5 p-6 sm:p-8" data-reveal>
      <form id="buildForm">
        <%- include('../partials/build-form-fields', { fields: fields, ui: {
          label: 'hc-label', input: 'hc-input', textarea: 'hc-textarea', select: 'hc-select',
          selectWrap: 'hc-select-wrap', optionList: 'hc-option-list', optionItem: 'hc-option-item',
          file: 'hc-file-input', imagePreview: 'hc-image-preview', hint: 'mt-1 text-xs text-hc-ink/50',
          required: 'text-hc-blue', icons: true, emailLabel: 'Your email'
        } }) %>

        <p id="formError" class="hc-msg hc-msg-error" style="display:none;"></p>
        <button type="submit" id="submitBtn" class="hc-pill-btn mt-6 w-full">Build my site</button>
        <!-- v1.2.1 Part B: plain expectation-setting line before submit,
             swapped by public/site.js for rotating status text once the
             generate request is actually in flight. Never both at once. -->
        <p id="buildStatusHint" class="mt-3 text-center text-xs text-hc-ink/50" aria-live="polite">This usually takes under a minute.</p>
      </form>
    </div>
  </div>
</main>

<%
  // v1.2.12: reviews for this website type. When the list is empty NOTHING
  // is rendered: no heading, no wrapper, no spacing, no comment, nothing a
  // visitor could use to tell the feature exists. Individual ratings only.
  // The type title is left out here (it would repeat this page's own type).
  // The link to /testimonials appears only while that page is switched on.
%>
<% if (typeof typeReviews !== 'undefined' && typeReviews.length > 0) { %>
<link rel="stylesheet" href="/reviews-display.css">
<section class="rvd-build" aria-label="Client reviews">
  <div class="rvd-section">
    <div class="rvd-grid<%= typeReviews.length >= 3 ? ' rvd-grid-3' : '' %>">
      <% typeReviews.forEach(function (review) { %>
        <%- include('../partials/public-review-card', { review: review, showType: false }) %>
      <% }); %>
    </div>
    <% if (siteSettings.testimonials_page_enabled === 'true') { %>
      <p class="rvd-more"><a class="rvd-link" href="/testimonials">Read all client reviews</a></p>
    <% } %>
  </div>
</section>
<% } %>

<script type="application/json" id="fieldKeysData"><%- JSON.stringify(fields.map(function (f) { return { key: f.fieldKey, type: f.fieldType, required: f.isRequired }; })) %></script>
<%- include('../partials/public-footer') %>
<%- include('../partials/public-footer-scripts') %>
</body>
</html>
