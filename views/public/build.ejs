<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/public-head') %>
</head>
<body class="bg-white font-sans text-hc-ink antialiased" data-page="build" data-slug="<%= websiteType.slug %>" data-website-type-id="<%= websiteType.id %>">
<%- include('../partials/public-body-start-scripts') %>

<%- include('../partials/public-nav') %>

<!-- v1.0.9 Part B: an icon per field TYPE, not per field — only where one
     genuinely fits (email/date/password have an obvious pictogram; a
     generic text/number/dropdown/radio/checkboxes field gets none rather
     than a forced, meaningless icon). -->
<% function iconForFieldType(type) {
  if (type === 'email') return 'mail';
  if (type === 'date') return 'calendar';
  if (type === 'password') return 'lock';
  return null;
} %>

<section class="bg-hc-blue px-4 py-12 text-center sm:px-6 sm:py-16">
  <div class="mx-auto max-w-2xl" data-reveal>
    <p class="mb-3 inline-block rounded-full bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-hc-yellow">
      <%= websiteType.name %>
    </p>
    <h1 class="font-display text-3xl uppercase text-white sm:text-4xl">Let's get the details</h1>
    <p class="mt-4 text-lg font-semibold text-white"><%= websiteType.displayPrimary %></p>
    <% if (websiteType.displaySecondary) { %><p class="text-sm text-white/70"><%= websiteType.displaySecondary %></p><% } %>
  </div>
</section>

<main class="bg-white px-4 py-12 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <div class="hc-panel border border-black/5 p-6 sm:p-8" data-reveal>
      <form id="buildForm">
        <!-- Fixed on every website type, regardless of template_fields:
             this is how the client receives their site later, so it's a
             permanent part of the form rather than a configurable field. -->
        <label class="hc-label" for="client_email">
          <span class="hc-label-icon"><%- getIconSvg('mail') %></span>
          Your email <span class="text-hc-blue">*</span>
        </label>
        <input class="hc-input" type="email" name="client_email" id="client_email" required placeholder="you@example.com">

        <% fields.forEach(function (f) { %>
          <% var fieldIcon = iconForFieldType(f.fieldType); %>
          <label class="hc-label">
            <% if (fieldIcon) { %><span class="hc-label-icon"><%- getIconSvg(fieldIcon) %></span><% } %>
            <%= f.fieldLabel %><% if (f.isRequired) { %> <span class="text-hc-blue">*</span><% } %>
          </label>

          <% if (f.fieldType === 'textarea') { %>
            <textarea class="hc-textarea" name="<%= f.fieldKey %>" id="field_<%= f.fieldKey %>" <%= f.isRequired ? 'required' : '' %> placeholder="<%= f.placeholderText %>"></textarea>
          <% } else if (f.fieldType === 'dropdown') { %>
            <div class="hc-select-wrap">
              <select class="hc-select" name="<%= f.fieldKey %>" id="field_<%= f.fieldKey %>" <%= f.isRequired ? 'required' : '' %>>
                <option value="">-- select --</option>
                <% (f.dropdownOptions || []).forEach(function (opt) { %>
                  <option value="<%= opt %>"><%= opt %></option>
                <% }); %>
              </select>
              <span class="hc-select-chevron"><%- getIconSvg('chevron-down') %></span>
            </div>
          <% } else if (f.fieldType === 'radio') { %>
            <div class="hc-option-list" data-field="<%= f.fieldKey %>">
              <% (f.dropdownOptions || []).forEach(function (opt, i) { %>
                <label class="hc-option-item">
                  <input type="radio" name="field_<%= f.fieldKey %>" value="<%= opt %>" <%= (f.isRequired && i === 0) ? 'required' : '' %>>
                  <span><%= opt %></span>
                </label>
              <% }); %>
            </div>
          <% } else if (f.fieldType === 'checkboxes') { %>
            <div class="hc-option-list" data-field="<%= f.fieldKey %>">
              <% (f.dropdownOptions || []).forEach(function (opt) { %>
                <label class="hc-option-item">
                  <input type="checkbox" name="field_<%= f.fieldKey %>" value="<%= opt %>">
                  <span><%= opt %></span>
                </label>
              <% }); %>
            </div>
          <% } else { %>
            <input class="hc-input" type="<%= f.fieldType %>" name="<%= f.fieldKey %>" id="field_<%= f.fieldKey %>" <%= f.isRequired ? 'required' : '' %> placeholder="<%= f.placeholderText %>">
          <% } %>
        <% }); %>

        <p id="formError" class="hc-msg hc-msg-error" style="display:none;"></p>
        <button type="submit" id="submitBtn" class="hc-pill-btn mt-6 w-full">Generate my site</button>
      </form>
    </div>
  </div>
</main>

<script type="application/json" id="fieldKeysData"><%- JSON.stringify(fields.map(function (f) { return { key: f.fieldKey, type: f.fieldType, required: f.isRequired }; })) %></script>
<%- include('../partials/public-footer') %>
<%- include('../partials/public-footer-scripts') %>
</body>
</html>
