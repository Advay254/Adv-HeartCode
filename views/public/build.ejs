<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/public-head') %>
</head>
<body data-page="build" data-slug="<%= websiteType.slug %>">
<%- include('../partials/public-body-start-scripts') %>
<div class="site-shell">
  <header class="site-header">
    <a href="/">← HeartCode</a>
    <h1><%= websiteType.name %></h1>
    <p class="price"><%= websiteType.displayPrimary %></p>
    <% if (websiteType.displaySecondary) { %><p class="price-secondary"><%= websiteType.displaySecondary %></p><% } %>
  </header>
  <main class="site-main">
    <form id="buildForm">
      <!-- Fixed on every website type, regardless of template_fields: this
           is how the client receives their site later, so it's a permanent
           part of the form rather than a configurable field. -->
      <label>Your email <span class="req">*</span>
        <input type="email" name="client_email" id="client_email" required placeholder="you@example.com">
      </label>

      <% fields.forEach(function (f) { %>
        <label>
          <%= f.fieldLabel %><% if (f.isRequired) { %> <span class="req">*</span><% } %>
          <% if (f.fieldType === 'textarea') { %>
            <textarea name="<%= f.fieldKey %>" id="field_<%= f.fieldKey %>" <%= f.isRequired ? 'required' : '' %> placeholder="<%= f.placeholderText %>"></textarea>
          <% } else if (f.fieldType === 'dropdown') { %>
            <select name="<%= f.fieldKey %>" id="field_<%= f.fieldKey %>" <%= f.isRequired ? 'required' : '' %>>
              <option value="">-- select --</option>
              <% (f.dropdownOptions || []).forEach(function (opt) { %>
                <option value="<%= opt %>"><%= opt %></option>
              <% }); %>
            </select>
          <% } else if (f.fieldType === 'radio') { %>
            <span class="radio-group" data-field="<%= f.fieldKey %>">
              <% (f.dropdownOptions || []).forEach(function (opt, i) { %>
                <label class="option-label">
                  <input type="radio" name="field_<%= f.fieldKey %>" value="<%= opt %>" <%= (f.isRequired && i === 0) ? 'required' : '' %>>
                  <%= opt %>
                </label>
              <% }); %>
            </span>
          <% } else if (f.fieldType === 'checkboxes') { %>
            <span class="checkbox-group" data-field="<%= f.fieldKey %>">
              <% (f.dropdownOptions || []).forEach(function (opt) { %>
                <label class="option-label">
                  <input type="checkbox" name="field_<%= f.fieldKey %>" value="<%= opt %>">
                  <%= opt %>
                </label>
              <% }); %>
            </span>
          <% } else { %>
            <input type="<%= f.fieldType %>" name="<%= f.fieldKey %>" id="field_<%= f.fieldKey %>" <%= f.isRequired ? 'required' : '' %> placeholder="<%= f.placeholderText %>">
          <% } %>
        </label>
      <% }); %>

      <p id="formError" class="msg msg-error" style="display:none;"></p>
      <button type="submit" id="submitBtn" style="margin-top:1rem;">Generate my site</button>
    </form>
  </main>
</div>

<script type="application/json" id="fieldKeysData"><%- JSON.stringify(fields.map(function (f) { return { key: f.fieldKey, type: f.fieldType, required: f.isRequired }; })) %></script>
<script src="/site.js" defer></script>
<%- include('../partials/public-footer-scripts') %>
</body>
</html>
