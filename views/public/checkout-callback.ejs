<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/public-head') %>
</head>
<body class="bg-white font-sans text-hc-ink antialiased" data-page="checkout-callback">
<%- include('../partials/public-body-start-scripts') %>

<%- include('../partials/public-nav') %>

<main class="bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-md text-center" data-reveal>
    <% if (outcome === 'success') { %>
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-hc-blue/10 text-hc-blue [&>svg]:h-7 [&>svg]:w-7">
        <%- getIconSvg('circle-check') %>
      </div>
      <h1 class="mt-5 font-display text-3xl uppercase text-hc-ink">Your site is live!</h1>
      <div class="hc-panel mt-6 border border-black/5 p-6">
        <a href="<%= siteUrl %>" class="hc-site-link break-all text-sm font-semibold text-hc-blue hover:underline" aria-disabled="true" tabindex="-1"><%= siteUrl %></a>
      </div>
      <p class="mt-4 text-sm text-hc-ink/60">We've also emailed you this link (and your site password, if you set one).</p>
      <a href="<%= siteUrl %>" id="visitSiteBtn" class="hc-site-link hc-pill-btn mt-6" aria-disabled="true" tabindex="-1">Visit your site</a>
      <p id="siteLinkCountdown" class="mt-2 text-xs font-medium uppercase tracking-wide text-hc-ink/50">Finishing up… <span id="siteLinkCountdownSeconds">20</span>s</p>
      <p class="mt-6 text-xs text-hc-ink/50">
        Didn't get the email? Check your spam or junk folder, and if it's there, mark it as "not spam" so future updates from us land in your inbox instead.
      </p>
    <% } else if (outcome === 'not_paid') { %>

      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-100 text-amber-700 [&>svg]:h-7 [&>svg]:w-7">
        <%- getIconSvg('credit-card') %>
      </div>
      <h1 class="mt-5 font-display text-3xl uppercase text-hc-ink">Payment not completed</h1>
      <p class="hc-msg hc-msg-warning">It looks like this payment wasn't completed. You have not been charged.</p>
      <% if (slug) { %><a href="/build/<%= slug %>/checkout" class="hc-pill-btn-outline mt-6">Try again</a><% } %>
    <% } else if (outcome === 'expired') { %>
      <h1 class="font-display text-3xl uppercase text-hc-ink">This checkout session expired</h1>
      <p class="hc-msg hc-msg-warning">Checkout sessions are only valid for an hour. Please start over.</p>
      <% if (slug) { %><a href="/build/<%= slug %>" class="hc-pill-btn-outline mt-6">Start over</a><% } %>
    <% } else if (outcome === 'not_found') { %>
      <h1 class="font-display text-3xl uppercase text-hc-ink">We couldn't find this checkout</h1>
      <p class="hc-msg hc-msg-error">This reference doesn't match anything on file.</p>
      <a href="/" class="hc-pill-btn-outline mt-6">← Back home</a>
    <% } else { %>
      <h1 class="font-display text-3xl uppercase text-hc-ink">Something went wrong</h1>
      <p class="hc-msg hc-msg-error">
        We hit a problem finishing this deployment.
        <% if (reference) { %>If you were charged, contact support and quote this reference: <strong><%= reference %></strong><% } %>
      </p>
    <% } %>
  </div>
</main>

<%- include('../partials/public-footer') %>
<%- include('../partials/public-footer-scripts') %>
</body>
</html>
