<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/public-head') %>
</head>
<body class="bg-white font-sans text-hc-ink antialiased" data-page="explore">
<%- include('../partials/public-body-start-scripts') %>

<%- include('../partials/public-nav') %>

<section class="bg-hc-blue px-4 py-14 text-center sm:px-6 sm:py-20">
  <div class="mx-auto max-w-3xl" data-reveal>
    <p class="mb-3 inline-block rounded-full bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-hc-yellow">
      Website types
    </p>
    <h1 class="font-display text-4xl uppercase text-white sm:text-5xl">Find your kind of site</h1>
    <p class="mt-4 text-base text-white/80 sm:text-lg">
      Every price below is already converted to your own currency — pick a type to see the form.
    </p>
  </div>
</section>

<main class="bg-white px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <%# v1.1.6 Part E: every card description below now carries
        line-clamp-2 -- a display-only visual cap, not a data change. A
        description saved before this version's 140-character server-side
        limit existed can still be arbitrarily long in the database; this
        keeps ANY length from stretching one grid row taller than its
        siblings (CSS Grid stretches every item in a row to the tallest),
        without truncating or otherwise touching the stored value itself. %>
    <% if (categories.length === 0) { %>
      <%# v1.1.4 Part D: zero categories exist at all -- render EXACTLY as
          this page did before this version (flat grid, no category UI),
          not a "0 categories" empty-state variant of the new layout. %>
      <% if (websiteTypes.length === 0) { %>
        <div class="mx-auto max-w-md py-16 text-center" data-reveal>
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-hc-blue/10 text-hc-blue [&>svg]:h-6 [&>svg]:w-6">
            <%- getIconSvg('sparkles') %>
          </div>
          <h2 class="mt-5 text-lg font-semibold text-hc-ink">Nothing available right now</h2>
          <p class="mt-2 text-sm text-hc-ink/60">Check back soon — new website types are added regularly.</p>
        </div>
      <% } else { %>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% websiteTypes.forEach(function (t) { %>
            <div class="hc-panel hc-panel-hover flex flex-col p-6" data-reveal>
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-hc-blue/10 text-hc-blue [&>svg]:h-6 [&>svg]:w-6">
                <%- getIconSvg(t.iconName) %>
              </div>
              <h2 class="mt-4 text-lg font-semibold text-hc-ink"><%= t.name %></h2>
              <p class="mt-1 line-clamp-2 flex-1 text-sm text-hc-ink/60"><%= t.description %></p>
              <div class="mt-5">
                <p class="text-base font-semibold text-hc-blue"><%= t.displayPrimary %></p>
                <% if (t.displaySecondary) { %><p class="text-xs text-hc-ink/50"><%= t.displaySecondary %></p><% } %>
              </div>
              <a href="/build/<%= t.slug %>" class="hc-pill-btn mt-5 w-full">Build this</a>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } else { %>
      <%# v1.1.4 Part D: at least one active category exists -- category
          cards first, each linking to /explore/:slug, then a "More
          Website Types" fallback grid for anything uncategorized (or
          pointing at a since-deactivated category) so nothing silently
          disappears. %>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% categories.forEach(function (c) { %>
          <a href="/explore/<%= c.slug %>" class="hc-panel hc-panel-hover flex flex-col p-6" data-reveal>
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-hc-blue/10 text-hc-blue [&>svg]:h-6 [&>svg]:w-6">
              <%- getIconSvg(c.iconName) %>
            </div>
            <h2 class="mt-4 text-lg font-semibold text-hc-ink"><%= c.name %></h2>
            <p class="mt-1 line-clamp-2 flex-1 text-sm text-hc-ink/60"><%= c.description %></p>
            <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-hc-blue"><%= c.typeCount %> website type<%= c.typeCount === 1 ? '' : 's' %></p>
          </a>
        <% }); %>
      </div>

      <% if (uncategorizedTypes.length > 0) { %>
        <h2 class="mt-14 font-display text-2xl uppercase text-hc-ink">More Website Types</h2>
        <p class="mt-1 max-w-xl text-sm text-hc-ink/60">Not yet sorted into a category.</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% uncategorizedTypes.forEach(function (t) { %>
            <div class="hc-panel hc-panel-hover flex flex-col p-6" data-reveal>
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-hc-blue/10 text-hc-blue [&>svg]:h-6 [&>svg]:w-6">
                <%- getIconSvg(t.iconName) %>
              </div>
              <h2 class="mt-4 text-lg font-semibold text-hc-ink"><%= t.name %></h2>
              <p class="mt-1 line-clamp-2 flex-1 text-sm text-hc-ink/60"><%= t.description %></p>
              <div class="mt-5">
                <p class="text-base font-semibold text-hc-blue"><%= t.displayPrimary %></p>
                <% if (t.displaySecondary) { %><p class="text-xs text-hc-ink/50"><%= t.displaySecondary %></p><% } %>
              </div>
              <a href="/build/<%= t.slug %>" class="hc-pill-btn mt-5 w-full">Build this</a>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } %>
  </div>
</main>

<%- include('../partials/public-footer') %>
<%- include('../partials/public-footer-scripts') %>
</body>
</html>
