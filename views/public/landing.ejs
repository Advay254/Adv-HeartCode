<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/public-head') %>
</head>
<body class="bg-white font-poppins text-hc-ink antialiased" data-page="home">
<%- include('../partials/public-body-start-scripts') %>

<%- include('../partials/landing-sections/hero', { section: heroSection }) %>

<!-- STATS + WEBSITE-TYPE TEASER GRID: kept as fixed, non-CMS sections —
     NOT part of landing_sections. The stats counter is the "honest stats
     counter" the v1.1.3 build brief itself says not to rebuild under a
     different name; the type-teaser grid is the page's actual
     navigation into /build/:slug, which a purely visual redesign
     shouldn't remove. Both are unchanged from the pre-redesign page
     other than inheriting this page's new font-poppins default (their
     own font-display/font-sans overrides below still apply where they
     already did). See this version's delivery notes. -->
<section class="bg-hc-ink px-4 py-16 text-center sm:px-6">
  <div class="mx-auto max-w-2xl" data-reveal>
    <p class="font-display text-6xl text-hc-yellow sm:text-7xl">
      <span data-countup="<%= statsNumber %>">0</span>
    </p>
    <p class="mt-3 text-sm uppercase tracking-widest text-white/70"><%= siteSettings.manual_stats_label %></p>
  </div>
</section>

<section class="bg-white px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-sk-blue">Website types</p>
        <h2 class="mt-3 text-3xl font-bold text-hc-ink sm:text-4xl">Built for your kind of business</h2>
      </div>
      <a href="/explore" class="hc-pill-btn-outline hidden sm:inline-flex">See all types</a>
    </div>

    <% if (typeTeasers.length === 0) { %>
      <p class="mt-10 text-center text-hc-ink/60">Nothing available right now — check back soon.</p>
    <% } else { %>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% typeTeasers.forEach(function (t) { %>
          <a href="/build/<%= t.slug %>" class="hc-panel hc-panel-hover block p-6" data-reveal>
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-hc-blue/10 text-hc-blue [&>svg]:h-6 [&>svg]:w-6">
              <%- getIconSvg(t.iconName) %>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-hc-ink"><%= t.name %></h3>
            <p class="mt-1 line-clamp-2 text-sm text-hc-ink/60"><%= t.description %></p>
            <p class="mt-4 text-base font-semibold text-hc-blue"><%= t.displayPrimary %></p>
          </a>
        <% }); %>
      </div>
    <% } %>

    <div class="mt-10 flex justify-center sm:hidden">
      <a href="/explore" class="hc-pill-btn-outline">See all types</a>
    </div>
  </div>
</section>

<%
  // Every remaining active section, in display_order — hero and footer
  // are excluded from middleSections by routes/public.js so they can
  // never appear twice (once here, once in their own guaranteed slot).
  var SECTION_PARTIALS = {
    feature_cards: '../partials/landing-sections/feature-cards',
    split_image_text: '../partials/landing-sections/split-image-text',
    cta_image_cards: '../partials/landing-sections/cta-image-cards',
    bullet_list: '../partials/landing-sections/bullet-list',
    testimonials: '../partials/landing-sections/testimonials'
  };
%>
<% middleSections.forEach(function (section) { %>
  <% var partialPath = SECTION_PARTIALS[section.sectionType]; %>
  <% if (partialPath) { %>
    <%- include(partialPath, { section: section }) %>
  <% } %>
<% }); %>

<% if (footerSection) { %>
  <%- include('../partials/landing-sections/footer', { section: footerSection }) %>
<% } else { %>
  <!-- Zero-sections fresh-install fallback (see routes/public.js) — a
       minimal footer that doesn't depend on any landing_sections row
       existing, so the page always has basic navigation even before an
       admin has touched anything. -->
  <footer class="border-t border-black/5 bg-white px-4 py-8 text-center font-poppins text-xs text-hc-ink/40 sm:px-6">
    &copy; <%= new Date().getFullYear() %> <%= siteSettings.site_title %>. All rights reserved.
  </footer>
<% } %>

<%- include('../partials/public-footer-scripts') %>
</body>
</html>
