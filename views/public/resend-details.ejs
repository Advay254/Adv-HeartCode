<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/public-head') %>
</head>
<body class="bg-white font-sans text-hc-ink antialiased" data-page="resend-details">
<%- include('../partials/public-body-start-scripts') %>

<%- include('../partials/public-nav') %>

<section class="bg-hc-blue px-4 py-12 text-center sm:px-6 sm:py-16">
  <div class="mx-auto max-w-2xl" data-reveal>
    <h1 class="font-display text-3xl uppercase text-white sm:text-4xl">Lost your site link?</h1>
    <p class="mt-3 text-sm text-white/80">Enter the email you used at checkout and we'll resend your site details.</p>
  </div>
</section>

<main class="bg-white px-4 py-12 sm:px-6">
  <div class="mx-auto max-w-md">
    <div class="hc-panel border border-black/5 p-6 sm:p-8" data-reveal>
      <div id="resendDetailsForm">
        <label class="hc-label" for="resendEmail">
          <span class="hc-label-icon"><%- getIconSvg('mail') %></span>
          Email address
        </label>
        <input class="hc-input" type="email" id="resendEmail" placeholder="you@example.com" autocomplete="email">
        <p id="resendDetailsError" class="hc-msg hc-msg-error" style="display:none;"></p>
        <button type="button" id="resendDetailsSubmitBtn" class="hc-pill-btn mt-6 w-full">Resend my site details</button>
      </div>
      <div id="resendDetailsResult" style="display:none;">
        <p class="text-sm text-hc-ink"></p>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/public-footer') %>
<%- include('../partials/public-footer-scripts') %>
</body>
</html>
