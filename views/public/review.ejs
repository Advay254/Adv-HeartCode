<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="referrer" content="no-referrer">
<title>Leave a review | HeartCode</title>
<%#
  Standalone page on purpose: it does not include public-head.ejs, so none of
  the site-wide injected scripts (analytics snippets, funnel.js,
  site-interactions.js) ever load here or see the review token in the URL.
  Only the compiled stylesheet (for the fonts and brand colour variables) and
  this page's own review.css / review.js. No inline script, no inline style,
  no inline event handler anywhere, which is what lets the page's CSP block
  inline and third-party scripts outright.
%>
<link rel="stylesheet" href="/styles/main.css">
<link rel="stylesheet" href="/review.css">
<script src="/review.js" defer></script>
</head>
<body class="rv-body">
<main class="rv-wrap">
  <div class="rv-card" id="reviewCard">
    <div class="rv-brand"><span class="rv-brand-mark"><%- getIconSvg('heart') %></span><span>HeartCode</span></div>

    <div id="reviewFormView">
      <h1 class="rv-title">How was your experience?</h1>
      <p class="rv-lead">Your support means a lot to us. A short review takes about a minute.</p>

      <noscript><p class="rv-alert rv-alert-error">This form needs JavaScript to be turned on.</p></noscript>

      <form id="reviewForm" novalidate
            data-action="/api/review/<%= token %>"
            data-csrf="<%= csrfValue %>"
            data-name-max="<%= limits.nameMax %>"
            data-text-max="<%= limits.testimonialMax %>"
            data-text-min="<%= limits.testimonialMin %>"
            data-image-max="<%= limits.imageMaxBytes %>">

        <p id="formAlert" class="rv-alert rv-alert-error" role="alert" hidden></p>

        <div class="rv-field">
          <label class="rv-label" for="rvName">Your name</label>
          <input class="rv-input" type="text" id="rvName" name="name" maxlength="<%= limits.nameMax %>" autocomplete="name" aria-describedby="rvNameHint rvNameCount rvNameError" required>
          <div class="rv-row">
            <p class="rv-hint" id="rvNameHint">First name and last initial is fine.</p>
            <p class="rv-count" id="rvNameCount" aria-live="off">0 / <%= limits.nameMax %></p>
          </div>
          <p class="rv-error" id="rvNameError" hidden></p>
        </div>

        <fieldset class="rv-field rv-fieldset">
          <legend class="rv-label">Your rating</legend>
          <div class="rv-stars" id="rvStars" role="radiogroup" aria-label="Star rating from 1 to 5">
            <% for (var s = 5; s >= 1; s--) { %>
              <input class="rv-star-input" type="radio" name="rating" id="rvStar<%= s %>" value="<%= s %>">
              <label class="rv-star-label" for="rvStar<%= s %>" title="<%= s %> star<%= s === 1 ? '' : 's' %>">
                <span class="rv-sr-only"><%= s %> star<%= s === 1 ? '' : 's' %></span>
                <svg class="rv-star" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              </label>
            <% } %>
          </div>
          <p class="rv-error" id="rvRatingError" hidden></p>
        </fieldset>

        <div class="rv-field">
          <label class="rv-label" for="rvText">Your review</label>
          <textarea class="rv-input rv-textarea" id="rvText" name="testimonial" rows="6" maxlength="<%= limits.testimonialMax %>" aria-describedby="rvTextHint rvTextCount rvTextError" required></textarea>
          <div class="rv-row">
            <p class="rv-hint" id="rvTextHint">At least <%= limits.testimonialMin %> characters. Plain text only, please leave out web addresses.</p>
            <p class="rv-count" id="rvTextCount" aria-live="off">0 / <%= limits.testimonialMax %></p>
          </div>
          <p class="rv-error" id="rvTextError" hidden></p>
        </div>

        <div class="rv-field">
          <span class="rv-label" id="rvImageLabel">Add a photo (optional)</span>
          <div class="rv-photo-row">
            <label class="rv-btn rv-btn-secondary" for="rvImage" id="rvImagePick">Choose photo</label>
            <input class="rv-sr-only" type="file" id="rvImage" name="image" accept="image/jpeg,image/png,image/webp" aria-labelledby="rvImageLabel rvImageName">
            <button type="button" class="rv-btn rv-btn-ghost" id="rvImageRemove" hidden>Remove</button>
          </div>
          <p class="rv-hint" id="rvImageHint">One photo only. JPEG, PNG or WebP, up to 5 MB.</p>
          <div class="rv-preview" id="rvPreviewBox" hidden>
            <img id="rvPreview" alt="Preview of the photo you chose" width="96" height="96">
            <span id="rvImageName" class="rv-hint"></span>
          </div>
          <p class="rv-error" id="rvImageError" hidden></p>
          <p class="rv-alert rv-alert-warn" id="rvImageUploadFailed" role="alert" hidden></p>
        </div>

        <button class="rv-btn rv-btn-primary" type="submit" id="rvSubmit">
          <span id="rvSubmitLabel">Send review</span>
        </button>
      </form>
    </div>

    <div id="reviewDoneView" class="rv-done" hidden>
      <span class="rv-done-icon"><%- getIconSvg('circle-check') %></span>
      <h1 class="rv-title">Thank you</h1>
      <p class="rv-lead">Your review is being looked at. We really appreciate you taking the time to share it.</p>
    </div>
  </div>
</main>
</body>
</html>
